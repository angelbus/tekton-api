        <mxCell id="wT1aa4JAPsMpaFoflDTs-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;verticalAlign=top;align=left;fontStyle=1;fontSize=12;" value="Reactive Architecture with Protobuf + Redis Streams" vertex="1">
          <mxGeometry height="220" width="1100" x="570" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="wT1aa4JAPsMpaFoflDTs-73" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef5e7;strokeColor=#f39c12;align=left;fontSize=10;fontStyle=2;" value="Flow:&#xa;0. Register Protobuf schemas in Glue&#xa;1. MSK Kafka receives Protobuf bytes&#xa;2. Lambda triggered with raw bytes&#xa;3. Schema Validator deserializes + validates&#xa;4. Calibration Service receives JSON&#xa;5. Grid Connector calls GRID API&#xa;6. GRID publishes to Redis Stream (XADD)&#xa;7. Response Handler consumes from Stream (XREADGROUP)" vertex="1">
          <mxGeometry height="160" width="500" x="590" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="wT1aa4JAPsMpaFoflDTs-74" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#00b894;align=left;fontSize=10;" value="✅ Key Benefits:&#xa;&#xa;• Protobuf validation at entry point&#xa;• Type safety &amp; schema enforcement&#xa;• Smaller message sizes (bandwidth savings)&#xa;• Redis Streams = No blocking BLPOP&#xa;• Consumer Groups = Natural load balancing&#xa;• Horizontal scalability (add consumers)&#xa;• Message replay capability&#xa;• At-least-once delivery guarantee&#xa;• No coordinator needed&#xa;• GRID unchanged (external dependency)" vertex="1">
          <mxGeometry height="160" width="540" x="1110" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="wT1aa4JAPsMpaFoflDTs-75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;align=left;fontSize=9;fontStyle=2;" value="Redis Streams vs BLPOP:&#xa;• Stream: XADD (publish) → XREADGROUP (consume with consumer groups)&#xa;• List: RPUSH (publish) → BLPOP (blocking pop, one consumer per key)&#xa;• Streams support multiple consumers via consumer groups&#xa;• Streams track consumer offsets automatically&#xa;• Streams allow message replay from any point" vertex="1">
          <mxGeometry height="70" width="1100" x="570" y="1525" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
