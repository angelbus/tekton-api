          <mxGeometry height="140" width="680" x="460" y="890" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#9B59B6;align=left;fontSize=10;" value="✅ Schema Validation at Entry Point&#xa;• Protobuf ensures type safety&#xa;• AWS Glue centralized schema management&#xa;• Invalid messages rejected early&#xa;• Schema evolution supported" vertex="1">
          <mxGeometry height="80" width="310" x="480" y="930" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f4e6;strokeColor=#00b894;align=left;fontSize=10;" value="✅ Efficiency Benefits&#xa;• Smaller message size (vs JSON)&#xa;• Faster serialization/deserialization&#xa;• Bandwidth savings in MSK&#xa;• Binary format = compact" vertex="1">
          <mxGeometry height="80" width="310" x="810" y="930" as="geometry" />
        </mxCell>
        <mxCell id="protobuf-example" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff6f00;align=left;fontSize=9;fontFamily=Courier New;" value="Example: CalibrationRequest.proto&#xa;&#xa;message CalibrationRequest {&#xa;  string request_id = 1;&#xa;  repeated double jacobians = 2;&#xa;  RegulationScenario scenario = 3;&#xa;  google.protobuf.Timestamp timestamp = 4;&#xa;}" vertex="1">
          <mxGeometry height="130" width="400" x="40" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="validation-flow" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef5e7;strokeColor=#f39c12;align=left;fontSize=9;" value="Validation Flow Details:&#xa;&#xa;1. Lambda receives binary Protobuf from MSK&#xa;2. Calls Schema Validator with payload&#xa;3. Validator fetches schema from Glue Registry&#xa;4. Deserializes using schema definition&#xa;5. Validates required fields, types, constraints&#xa;6. If valid: converts to JSON, passes to Calibration Service&#xa;7. If invalid: sends to DLQ with validation errors" vertex="1">
          <mxGeometry height="130" width="680" x="460" y="1050" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
