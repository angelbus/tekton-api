        <mxCell id="flow-legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;align=left;fontSize=10;fontStyle=2;" value="Flow:&#xa;0. Register Protobuf schemas in Glue&#xa;1. Kafka receives Protobuf bytes&#xa;2. Lambda triggered with raw bytes&#xa;3. Schema Validator deserializes + validates&#xa;4. Calibration Service receives JSON&#xa;[Rest of flow same as before]" vertex="1">
