        <mxCell id="advantage-events" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#4472C4;" value="&lt;b&gt;Real-Time Events (Lambda → SQS → Kafka):&lt;/b&gt;&lt;br&gt;✅ Immediate visibility (seconds)&lt;br&gt;✅ Alerting and monitoring&lt;br&gt;✅ Live dashboards&lt;br&gt;✅ Operational response" vertex="1">
          <mxGeometry height="120" width="550" x="200" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="advantage-files" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#27AE60;" value="&lt;b&gt;S3 Tracking Files (Filebeat → Logstash → OpenSearch):&lt;/b&gt;&lt;br&gt;✅ Immutable audit trail&lt;br&gt;✅ Replayable (disaster recovery)&lt;br&gt;✅ Rich execution metadata&lt;br&gt;✅ Works even if Kafka is down" vertex="1">
          <mxGeometry height="120" width="650" x="850" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="advantage-combined" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#D79B00;fontStyle=1" value="&lt;b&gt;Combined Benefits:&lt;/b&gt;&lt;br&gt;✅ Best of both worlds&lt;br&gt;✅ Resilient (dual paths)&lt;br&gt;✅ Complete picture&lt;br&gt;✅ No single point of failure" vertex="1">
          <mxGeometry height="120" width="450" x="1600" y="1700" as="geometry" />
        </mxCell>
