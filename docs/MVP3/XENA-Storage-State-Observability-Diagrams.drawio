rder-image: initial; padding: 0px;&quot;&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot; size=&quot;3&quot;&gt;  &quot;errorPath&quot;: &quot;s3://...&quot;&lt;/font&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot; size=&quot;3&quot;&gt;}&lt;/font&gt;&lt;/blockquote&gt;" vertex="1">
