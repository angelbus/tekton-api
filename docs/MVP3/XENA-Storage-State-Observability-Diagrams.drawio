        </mxCell>
        <mxCell id="data-plane-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;DATA PLANE&lt;/b&gt;&lt;br&gt;Business Data Processing (High Throughput)&lt;/font&gt;" vertex="1">
