        <mxCell id="kafka-handler-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#ED7100;" value="&lt;b&gt;KafkaEventHandler (Lambda)&lt;/b&gt;" vertex="1">
