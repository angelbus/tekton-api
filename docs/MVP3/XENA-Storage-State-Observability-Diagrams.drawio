        <mxCell id="idempotency-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="463" width="640" x="1666" y="677" as="geometry" />
        </mxCell>
        <mxCell id="idempotency-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#D79B00;" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Idempotency Tracking&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="800" x="1686" y="697" as="geometry" />
        </mxCell>
        <mxCell id="idempotency-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;processed:{messageId} (String with TTL)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;Key: processed:msg-abc-123&lt;br&gt;Value: &quot;1&quot;&lt;br&gt;TTL: 3600 seconds (1 hour)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Purpose:&lt;/b&gt;&lt;br&gt;Prevent duplicate processing from S3 duplicate events&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Logic:&lt;/b&gt;&lt;br&gt;1. Check if key exists before processing&lt;br&gt;2. If exists → skip (already processed)&lt;br&gt;3. If not exists → process + set key&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Auto-Expiry:&lt;/b&gt;&lt;br&gt;Keys expire after 1 hour (no manual cleanup)&lt;br&gt;&lt;b style=&quot;&quot;&gt;Memory:&lt;/b&gt;&lt;br&gt;~100 bytes per key × 50,000 keys = 5 MB&lt;/font&gt;" vertex="1">
          <mxGeometry height="350" width="760" x="1706" y="739" as="geometry" />
        </mxCell>
        <mxCell id="truth-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#CC0000;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="270" width="2310" x="100" y="1217" as="geometry" />
        </mxCell>
        <mxCell id="truth-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#CC0000;" value="&lt;b&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;⚠️ CRITICAL: Source of Truth Model&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="2270" x="120" y="1238" as="geometry" />
        </mxCell>
        <mxCell id="truth-content" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#CC0000;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Redis is NOT a source of truth.&lt;/b&gt; Redis is a &lt;b style=&quot;&quot;&gt;transient cache&lt;/b&gt; for fast lookups and reconciliation tracking.&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;The authoritative execution state resides in S3:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b style=&quot;&quot;&gt;_progress.json&lt;/b&gt; - Real-time execution state (written by GRID every 10 min or 500 items)&lt;br&gt;• &lt;b style=&quot;&quot;&gt;manifest.json&lt;/b&gt; - Final completion state (written LAST by GRID)&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="1010" x="200" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="reconciliation-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="476" width="2310" x="100" y="1524" as="geometry" />
        </mxCell>
        <mxCell id="reconciliation-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#27AE60;" value="&lt;b&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;ReconciliationJob - Universal Stall Detection&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="2270" x="120" y="1545" as="geometry" />
        </mxCell>
        <mxCell id="reconciliation-flow" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Reconciliation Flow (Every 10 Minutes):&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. EventBridge triggers ReconciliationJob Lambda&lt;br&gt;2. Scan xena:pending_jobs set in Redis&lt;br&gt;3. For each job:&lt;br&gt;   a. Read _progress.json from S3 (resultsPath)&lt;br&gt;   b. Check lastUpdate timestamp&lt;br&gt;   c. If no update &amp;gt;10 min → STALLED&lt;br&gt;   d. If no _progress.json after 5 min → NO_PROGRESS&lt;br&gt;4. For stalled jobs:&lt;br&gt;   a. Increment bookRetries counter&lt;br&gt;   b. Build reconciliation payload (control.reconciliation = true)&lt;br&gt;   c. Resubmit to grid-connector-queue&lt;br&gt;5. If bookRetries &amp;gt;= 5 → PERMANENTLY_FAILED (alert ops)&lt;/font&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="555" x="245" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="reconciliation-key" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;fontStyle=1" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;GRID Libraries Handle Reconciliation:&lt;/b&gt;&lt;br&gt;• Check S3 for existing results&lt;br&gt;• Skip already-processed items&lt;br&gt;• Process only missing/failed items&lt;br&gt;• Write new progress + manifest&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Result:&lt;/b&gt; Universal resilience without complexity&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="630" x="1683" y="1579" as="geometry" />
        </mxCell>
        <mxCell id="3S6fIXIDOASykBvcehVO-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#CC0000;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Redis is lost:&lt;/b&gt;&lt;br&gt;✅ Jobs continue processing (GRID independent)&lt;br&gt;✅ State can be rebuilt from S3 artifacts&lt;br&gt;✅ ReconciliationJob detects active jobs by scanning S3&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Redis Role:&lt;/b&gt; Fast lookup (~1ms) + Reconciliation tracking&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="669" x="1683" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="3S6fIXIDOASykBvcehVO-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Constants:&lt;/b&gt;&lt;br&gt;• MAX_INITIAL_WAIT = 300s (5 minutes)&lt;br&gt;• MAX_STALL_TIME = 600s (10 minutes)&lt;br&gt;• MAX_RECONCILIATION_RETRIES = 5&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;🎯 Key Insight:&lt;/b&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;ReconciliationJob is&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;&quot;&gt;library-agnostic&lt;/b&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;Works for ALL libraries without library-specific logic:&lt;/span&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;✅ Uses standard _progress.json contract&lt;/span&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;✅ Standard control.reconciliation flag&lt;/span&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;✅ Standard S3-based stall detection&lt;/span&gt;&lt;br style=&quot;font-weight: 700;&quot;&gt;&lt;span style=&quot;font-weight: 700;&quot;&gt;✅ No branching logic for library types&lt;/span&gt;&lt;/font&gt;&lt;br style=&quot;font-size: 22px; font-weight: 700;&quot;&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="555" x="1025" y="1600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
