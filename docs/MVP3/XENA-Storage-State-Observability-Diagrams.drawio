        <mxCell id="getafe-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#D79B00;" value="&lt;b&gt;GETAFE Platform (On-Premise)&lt;/b&gt;&lt;br&gt;Kafka → OpenSearch → Kibana" vertex="1">
          <mxGeometry height="50" width="560" x="120" y="828" as="geometry" />
        </mxCell>
        <mxCell id="getafe-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" value="&lt;b&gt;Components:&lt;/b&gt;&lt;br&gt;• Kafka: Event ingestion&lt;br&gt;• OpenSearch: Indexing (xena-events-* index)&lt;br&gt;• Kibana: Visualization &amp; dashboards&lt;br&gt;&lt;br&gt;&lt;b&gt;Capabilities:&lt;/b&gt;&lt;br&gt;• Real-time dashboards&lt;br&gt;• Historical trend analysis&lt;br&gt;• Cross-job correlation&lt;br&gt;• Ad-hoc querying&lt;br&gt;&lt;br&gt;&lt;b&gt;Retention:&lt;/b&gt;&lt;br&gt;• Hot: 7-14 days (SSD)&lt;br&gt;• Warm: 30-90 days (HDD)&lt;br&gt;• Cold: Optional archive" vertex="1">
          <mxGeometry height="190" width="500" x="150" y="888" as="geometry" />
        </mxCell>
