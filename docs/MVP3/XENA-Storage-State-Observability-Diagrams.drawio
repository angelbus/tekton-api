        <mxCell id="kafka-handler-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" value="&lt;b&gt;Processing:&lt;/b&gt;&lt;br&gt;• Consumes SQS messages (batch)&lt;br&gt;• Publishes to GETAFE Kafka topic&lt;br&gt;• Handles retry with exponential backoff&lt;br&gt;&lt;br&gt;&lt;b&gt;Connection:&lt;/b&gt;&lt;br&gt;• SSL/TLS with mutual auth&lt;br&gt;• Via VPN to on-premise GETAFE" vertex="1">
          <mxGeometry height="90" width="500" x="150" y="1408" as="geometry" />
        </mxCell>
