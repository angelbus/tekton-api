        <mxCell id="sqs-obs-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#E7157B;" value="&lt;b&gt;SQS: xena-observability-queue&lt;/b&gt;" vertex="1">
