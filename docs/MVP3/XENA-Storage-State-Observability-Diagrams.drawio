        </mxCell>
        <mxCell id="input-bucket-icon" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="295" y="280" as="geometry" />
        </mxCell>
        <mxCell id="input-bucket-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#7AA116;" value="&lt;b&gt;S3 Input Bucket&lt;/b&gt;&lt;br&gt;xena-data-lake-input-{env}" vertex="1">
          <mxGeometry height="40" width="310" x="180" y="370" as="geometry" />
        </mxCell>
        <mxCell id="input-bucket-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Purpose:&lt;/b&gt; Job submission storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Characteristics:&lt;/b&gt;&lt;br&gt;• Large objects (10 MB - 10 GB)&lt;br&gt;• High throughput (bursty)&lt;br&gt;• Immutable artifacts&lt;br&gt;&lt;br&gt;&lt;b&gt;Write Access:&lt;/b&gt;&lt;br&gt;XVA CCR Data Provisioning ONLY&lt;br&gt;&lt;br&gt;&lt;b&gt;Read Access:&lt;/b&gt;&lt;br&gt;• XENALoader Lambda&lt;br&gt;• GRID (cross-account)&lt;br&gt;&lt;br&gt;&lt;b&gt;Path Structure:&lt;/b&gt;&lt;br&gt;{library}/{country}/{purpose}/&lt;br&gt;{date}/{subpurpose}/{iteration}/&lt;br&gt;input.parquet&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="280" x="195" y="420" as="geometry" />
        </mxCell>
        <mxCell id="output-bucket-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="480" width="350" x="560" y="260" as="geometry" />
        </mxCell>
        <mxCell id="output-bucket-icon" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="695" y="280" as="geometry" />
        </mxCell>
        <mxCell id="output-bucket-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#7AA116;" value="&lt;b&gt;S3 Output Bucket&lt;/b&gt;&lt;br&gt;xena-data-lake-output-{env}" vertex="1">
          <mxGeometry height="40" width="310" x="580" y="370" as="geometry" />
        </mxCell>
        <mxCell id="output-bucket-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Purpose:&lt;/b&gt; Job results storage&lt;br&gt;&lt;br&gt;&lt;b&gt;Contains:&lt;/b&gt;&lt;br&gt;• results.parquet&lt;br&gt;• _progress.json (every 10 min)&lt;br&gt;• manifest.json (LAST)&lt;br&gt;&lt;br&gt;&lt;b&gt;Write Access:&lt;/b&gt;&lt;br&gt;GRID cross-account ONLY&lt;br&gt;&lt;br&gt;&lt;b&gt;Read Access:&lt;/b&gt;&lt;br&gt;• OutputHandler Lambda&lt;br&gt;• Client teams&lt;br&gt;&lt;br&gt;&lt;b&gt;Path Mirroring:&lt;/b&gt;&lt;br&gt;Replicates input hierarchy&lt;br&gt;for traceability&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="280" x="595" y="420" as="geometry" />
        </mxCell>
        <mxCell id="error-bucket-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AA116;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="480" width="350" x="960" y="260" as="geometry" />
        </mxCell>
        <mxCell id="error-bucket-icon" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="1095" y="280" as="geometry" />
        </mxCell>
        <mxCell id="error-bucket-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#7AA116;" value="&lt;b&gt;S3 Error Bucket&lt;/b&gt;&lt;br&gt;xena-data-lake-errors-{env}" vertex="1">
          <mxGeometry height="40" width="310" x="980" y="370" as="geometry" />
        </mxCell>
        <mxCell id="error-bucket-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Purpose:&lt;/b&gt; Failed items isolation&lt;br&gt;&lt;br&gt;&lt;b&gt;Contains:&lt;/b&gt;&lt;br&gt;• failed_items.parquet&lt;br&gt;• error_details.json&lt;br&gt;&lt;br&gt;&lt;b&gt;Write Access:&lt;/b&gt;&lt;br&gt;GRID cross-account ONLY&lt;br&gt;&lt;br&gt;&lt;b&gt;Read Access:&lt;/b&gt;&lt;br&gt;• ErrorHandler Lambda&lt;br&gt;• Ops teams&lt;br&gt;&lt;br&gt;&lt;b&gt;Retention:&lt;/b&gt;&lt;br&gt;7 days → Glacier&lt;br&gt;&lt;br&gt;&lt;b&gt;Use Case:&lt;/b&gt;&lt;br&gt;Investigation &amp;amp; retry&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="280" x="995" y="420" as="geometry" />
        </mxCell>
        <mxCell id="data-characteristics-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="290" width="1150" x="160" y="800" as="geometry" />
        </mxCell>
        <mxCell id="data-characteristics-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#27AE60;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Data Plane Characteristics&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1110" x="180" y="820" as="geometry" />
        </mxCell>
        <mxCell id="data-char-1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;✅ Large Objects&lt;/b&gt;&lt;br&gt;Parquet files: 10 MB - 10 GB&lt;br&gt;Optimized for bulk transfers&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="200" y="870" as="geometry" />
        </mxCell>
        <mxCell id="data-char-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ High Throughput&lt;/b&gt;&lt;br&gt;Bursty writes during batch windows&lt;br&gt;100+ jobs/min sustained&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="570" y="870" as="geometry" />
        </mxCell>
        <mxCell id="data-char-3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Immutable Artifacts&lt;/b&gt;&lt;br&gt;Once written, never modified&lt;br&gt;S3 versioning for recovery&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="940" y="870" as="geometry" />
        </mxCell>
        <mxCell id="data-char-4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Streaming Optimized&lt;/b&gt;&lt;br&gt;Row group-based processing&lt;br&gt;5,000 deals per row group&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="200" y="980" as="geometry" />
        </mxCell>
        <mxCell id="data-char-5" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Parallel Reads&lt;/b&gt;&lt;br&gt;Multiple GRID workers&lt;br&gt;Process chunks simultaneously&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="570" y="980" as="geometry" />
        </mxCell>
        <mxCell id="data-char-6" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Cross-Account Access&lt;/b&gt;&lt;br&gt;GRID reads/writes via IAM&lt;br&gt;ExternalId protection&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="330" x="940" y="980" as="geometry" />
        </mxCell>
        <mxCell id="contract-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="580" width="1150" x="160" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="contract-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#F4B183;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;📋 Contract Model - Hierarchical Path Structure&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1110" x="180" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="contract-structure" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Input Path Structure (Contract):&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;s3://xena-data-lake-input-{env}/&lt;br&gt;└── {jobType}/                 # Library (e.g., &quot;risk-factor&quot;)&lt;br&gt;    └── {country}/             # ISO 3166-1 (e.g., &quot;ES&quot;, &quot;US&quot;)&lt;br&gt;        └── {purpose}/         # Context (e.g., &quot;DAILY_BATCH&quot;)&lt;br&gt;            └── {date}/        # YYYYMMDD&lt;br&gt;                └── {subpurpose}/  # &quot;production&quot;, &quot;testing&quot;&lt;br&gt;                    └── {iteration}/   # 1, 2, 3...&lt;br&gt;                        └── input.parquet&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="1070" x="200" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="contract-examples" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Example Paths:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Production:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;s3://.../risk-factor/ES/DAILY_BATCH/20260426/production/1/input.parquet&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;UAT Testing:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;s3://.../pricing/US/ADHOC/20260426/testing/1/input.parquet&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Retry:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;s3://.../valuation/BR/INTRADAY/20260426/production/2/input.parquet&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="1070" x="200" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="contract-rule" parent="1" style="text;html=1;strokeColor=#CC0000;fillColor=#FFE6E6;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=10;fontStyle=1" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;⚠️ CRITICAL CONTRACT RULE:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each input MUST be a &lt;b style=&quot;&quot;&gt;single self-contained Parquet file&lt;/b&gt; with metadata in footer.&lt;br&gt;&lt;br&gt;❌ &lt;b style=&quot;&quot;&gt;NO secondary files allowed&lt;/b&gt; (no request.json, no separate metadata)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="1070" x="200" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="config-plane-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=4;" value="" vertex="1">
          <mxGeometry height="1640" width="1200" x="1420" y="140" as="geometry" />
        </mxCell>
        <mxCell id="config-plane-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#27AE60;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;CONFIGURATION PLANE&lt;/b&gt;&lt;br&gt;Execution Metadata (Low Frequency)&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="1210" x="1440" y="160" as="geometry" />
        </mxCell>
        <mxCell id="registry-bucket-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27AE60;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="480" width="1050" x="1490" y="260" as="geometry" />
        </mxCell>
        <mxCell id="registry-bucket-icon" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="1975" y="280" as="geometry" />
        </mxCell>
        <mxCell id="registry-bucket-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#27AE60;" value="&lt;b&gt;S3 Registry Bucket&lt;/b&gt;&lt;br&gt;xena-registry-{env}/libraries/registry.json" vertex="1">
          <mxGeometry height="40" width="1010" x="1510" y="370" as="geometry" />
        </mxCell>
        <mxCell id="registry-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;Purpose:&lt;/b&gt; Library catalog &amp;amp; version management&lt;br&gt;&lt;br&gt;&lt;b&gt;Characteristics:&lt;/b&gt;&lt;br&gt;• Small objects (~5 KB)&lt;br&gt;• Low frequency (release-time updates)&lt;br&gt;• Eventual consistency acceptable&lt;br&gt;&lt;br&gt;&lt;b&gt;Ownership:&lt;/b&gt;&lt;br&gt;GRID Team (authoritative source)&lt;br&gt;&lt;br&gt;&lt;b&gt;Write Access:&lt;/b&gt;&lt;br&gt;GRID deployment pipelines ONLY&lt;br&gt;&lt;br&gt;&lt;b&gt;Read Access:&lt;/b&gt;&lt;br&gt;• GRIDConnector Lambda (cached, 5 min TTL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Contains:&lt;/b&gt;&lt;br&gt;• Library names &amp;amp; versions&lt;br&gt;• Endpoint URLs&lt;br&gt;• Deprecation flags&lt;br&gt;• Capabilities metadata&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="965" x="1535" y="420" as="geometry" />
        </mxCell>
        <mxCell id="config-characteristics-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="300" width="1050" x="1490" y="800" as="geometry" />
        </mxCell>
        <mxCell id="config-characteristics-title" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=16;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;Configuration Plane Characteristics&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1010" x="1510" y="820" as="geometry" />
        </mxCell>
        <mxCell id="config-char-1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Small Objects&lt;/b&gt;&lt;br&gt;Registry: ~5 KB&lt;br&gt;Fast downloads&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="1530" y="870" as="geometry" />
        </mxCell>
        <mxCell id="config-char-2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Low Frequency&lt;/b&gt;&lt;br&gt;Updated on release&lt;br&gt;~1-2 times/week&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="1870" y="870" as="geometry" />
        </mxCell>
        <mxCell id="config-char-3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Cached Reads&lt;/b&gt;&lt;br&gt;5 min TTL in Lambda&lt;br&gt;&amp;lt;1ms latency (cache hit)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="2210" y="870" as="geometry" />
        </mxCell>
        <mxCell id="config-char-4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Eventual Consistency&lt;/b&gt;&lt;br&gt;5 min max staleness&lt;br&gt;Acceptable for registry&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="1530" y="980" as="geometry" />
        </mxCell>
        <mxCell id="config-char-5" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ No Database Needed&lt;/b&gt;&lt;br&gt;S3 sufficient for access pattern&lt;br&gt;Reduced complexity&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="1870" y="980" as="geometry" />
        </mxCell>
        <mxCell id="config-char-6" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#4472C4;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;✅ Version Resolution&lt;/b&gt;&lt;br&gt;GRID resolves at runtime&lt;br&gt;Staleness doesn&#39;t affect correctness&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="2210" y="980" as="geometry" />
        </mxCell>
        <mxCell id="registry-example-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#27AE60;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="580" width="1050" x="1490" y="1150" as="geometry" />
