        <mxCell id="kibana-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Dashboards:&lt;/b&gt;&lt;br&gt;• Real-Time Job Monitoring&lt;br&gt;• Library Performance&lt;br&gt;• Operational Health&lt;br&gt;• Audit Trail&lt;br&gt;&lt;br&gt;&lt;b&gt;Visualizes:&lt;/b&gt;&lt;br&gt;Both Kafka events AND&lt;br&gt;S3 tracking file data" vertex="1">
