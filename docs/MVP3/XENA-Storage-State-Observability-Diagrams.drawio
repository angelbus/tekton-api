  <diagram id="Functional-Storage-View" name="1. Functional - Storage Architecture">
    <mxGraphModel dx="3535" dy="1915" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="storage-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1F4E78;" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;XENA Storage Architecture - Dual-Plane Model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 24px;&quot;&gt;Separation of Business Data from Configuration Metadata&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="2490" x="100" y="20" as="geometry" />
        </mxCell>
        <mxCell id="data-plane-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;strokeWidth=4;" value="" vertex="1">
