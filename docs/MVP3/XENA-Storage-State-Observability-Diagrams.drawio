        <mxCell id="sqs-obs-content" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" value="&lt;b&gt;Purpose:&lt;/b&gt;&lt;br&gt;• Buffers events (decoupling layer)&lt;br&gt;• Handles retries and backpressure&lt;br&gt;• Retention: 14 days&lt;br&gt;&lt;br&gt;&lt;b&gt;Benefits:&lt;/b&gt;&lt;br&gt;✅ Lambda doesn&#39;t block on Kafka&lt;br&gt;✅ Automatic retry on failure&lt;br&gt;✅ Network issues don&#39;t block XENA" vertex="1">
          <mxGeometry height="90" width="900" x="950" y="1376" as="geometry" />
