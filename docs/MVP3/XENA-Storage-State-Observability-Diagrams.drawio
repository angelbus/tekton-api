        <mxCell id="pending-set" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;xena:pending_jobs (Set)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;{&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  &quot;job-20260426-001&quot;,&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  &quot;job-20260426-002&quot;,&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  &quot;job-20260426-003&quot;,&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  ...&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;Purpose:&lt;/b&gt;&lt;br&gt;ReconciliationJob scans this set&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="600" x="966" y="730" as="geometry" />
        </mxCell>
        <mxCell id="completed-set" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;xena:completed_jobs (Set)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;{&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 0px;&quot;&gt;&lt;font size=&quot;3&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  &quot;job-20260425-100&quot;,&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  &quot;job-20260425-101&quot;,&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;  ...&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;&lt;/blockquote&gt;&lt;font style=&quot;&quot; size=&quot;3&quot;&gt;&lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;&quot;&gt;TTL:&lt;/b&gt; 24 hours&lt;br&gt;&lt;b style=&quot;&quot;&gt;Purpose:&lt;/b&gt; Quick status lookup&lt;/font&gt;" vertex="1">
