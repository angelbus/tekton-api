        <mxCell id="wElA6TZ7euuHoQ-T8m9t-29" connectable="0" parent="wElA6TZ7euuHoQ-T8m9t-28" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;backgroundColor=#FFFFFF;fontStyle=1" value="Trigger" vertex="1">
