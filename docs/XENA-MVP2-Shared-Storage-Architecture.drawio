        <mxCell id="comparison-box" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;PARADIGM SHIFT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;❌ Old Pattern (Anti-pattern)&lt;/b&gt;&lt;br&gt;• GRID writes to Redis&lt;br&gt;• XENA polls (BLPOP)&lt;br&gt;• Payload copied over network&lt;br&gt;• Memory pressure in Pods&lt;br&gt;&lt;br&gt;&lt;b&gt;✅ MVP2 Pattern (Correct)&lt;/b&gt;&lt;br&gt;• GRID writes directly to S3&lt;br&gt;• XENA reacts to S3 event&lt;br&gt;• Zero polling&lt;br&gt;• Zero payload duplication&lt;br&gt;• Scales to 833+ ops/min" vertex="1">
          <mxGeometry height="220" width="265" x="1493" y="740" as="geometry" />
        </mxCell>
        <mxCell id="legend-box" parent="1" style="text;html=1;strokeColor=#5B9BD5;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E67E22&quot;&gt;━━━━&lt;/b&gt; Data Plane (Heavy payload)&lt;br&gt;&lt;b style=&quot;color:#000000&quot;&gt;━━━━&lt;/b&gt; Control Plane&lt;br&gt;&lt;b style=&quot;color:#F4B183&quot;&gt;- - - -&lt;/b&gt; Event notifications" vertex="1">
          <mxGeometry height="120" width="320" x="30" y="840" as="geometry" />
        </mxCell>
        <mxCell id="message-box" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontStyle=1" value="&lt;b&gt;KEY ARCHITECTURAL PRINCIPLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;🎯 S3 is the shared data plane&lt;br&gt;🎯 XENA does NOT fetch from GRID&lt;br&gt;🎯 GRID does NOT push payloads through Redis&lt;br&gt;🎯 All heavy payloads move directly between compute and S3&lt;br&gt;🎯 XENA reacts to storage events&lt;br&gt;&lt;br&gt;&lt;b&gt;This is NOT:&lt;/b&gt; Service → Service → Redis → Service&lt;br&gt;&lt;b&gt;This IS:&lt;/b&gt; Compute ↔ Shared Storage ↔ Event System" vertex="1">
          <mxGeometry height="180" width="430" x="30" y="980" as="geometry" />
        </mxCell>
        <mxCell id="AITTIbtTDZ4jWUz2gwIp-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1F4E78;strokeWidth=3;dashed=1;" value="" vertex="1">
          <mxGeometry height="260" width="325" x="65" y="530" as="geometry" />
        </mxCell>
        <mxCell id="AITTIbtTDZ4jWUz2gwIp-3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#1F4E78;fontStyle=1" value="SCIB Data Lake" vertex="1">
          <mxGeometry height="50" width="155" x="65" y="550" as="geometry" />
