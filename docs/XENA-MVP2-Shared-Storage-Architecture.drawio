        </mxCell>
        <mxCell id="Wy93tQOPNYs1G8XFxVIa-58" parent="Wy93tQOPNYs1G8XFxVIa-1" style="text;html=1;strokeColor=#C0504D;fillColor=#FFE6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;fontStyle=1;fontColor=#C0504D;" value="&lt;b&gt;❌ NO LONGER USED&lt;/b&gt;&lt;br&gt;&lt;br&gt;✗ No Redis polling (BLPOP)&lt;br&gt;✗ No payload relay through services&lt;br&gt;✗ No double network hops&lt;br&gt;✗ No memory pressure in Pods&lt;br&gt;✗ No payload duplication" vertex="1">
          <mxGeometry height="160" width="280" x="1404" y="630" as="geometry" />
        </mxCell>
        <mxCell id="Wy93tQOPNYs1G8XFxVIa-59" parent="Wy93tQOPNYs1G8XFxVIa-1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;PARADIGM SHIFT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;❌ Old Pattern&lt;/b&gt;&lt;br&gt;• GRID writes to Redis&lt;br&gt;• XENA polls (BLPOP)&lt;br&gt;• Payload copied over network&lt;br&gt;• Memory pressure in Pods&lt;br&gt;&lt;br&gt;&lt;b&gt;✅ MVP2 Pattern (Correct)&lt;/b&gt;&lt;br&gt;• GRID writes directly to S3&lt;br&gt;• XENA reacts to S3 event&lt;br&gt;• Zero polling&lt;br&gt;• Zero payload duplication&lt;br&gt;• Scales to 833+ ops/min" vertex="1">
          <mxGeometry height="200" width="265" x="490" y="600" as="geometry" />
        </mxCell>
        <mxCell id="Wy93tQOPNYs1G8XFxVIa-60" parent="Wy93tQOPNYs1G8XFxVIa-1" style="text;html=1;strokeColor=#5B9BD5;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E67E22&quot;&gt;━━━━&lt;/b&gt; Data Plane (Heavy payload)&lt;br&gt;&lt;b style=&quot;color:#000000&quot;&gt;━━━━&lt;/b&gt; Control Plane&lt;br&gt;&lt;b style=&quot;color:#F4B183&quot;&gt;- - - -&lt;/b&gt; Event notifications" vertex="1">
          <mxGeometry height="85" width="320" x="40" y="537.5" as="geometry" />
        </mxCell>
        <mxCell id="Wy93tQOPNYs1G8XFxVIa-61" parent="Wy93tQOPNYs1G8XFxVIa-1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontStyle=1" value="&lt;b&gt;KEY ARCHITECTURAL PRINCIPLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;🎯 S3 is the shared data plane&lt;br&gt;🎯 XENA does NOT fetch from GRID&lt;br&gt;🎯 GRID does NOT push payloads through Redis&lt;br&gt;🎯 All heavy payloads move directly between compute and S3&lt;br&gt;🎯 XENA reacts to storage events&lt;br&gt;&lt;br&gt;&lt;b&gt;This is NOT:&lt;/b&gt; Service → Service → Redis → Service&lt;br&gt;&lt;b&gt;This IS:&lt;/b&gt; Compute ↔ Shared Storage ↔ Event System" vertex="1">
          <mxGeometry height="170" width="430" x="40" y="635" as="geometry" />
        </mxCell>
        <mxCell id="Wy93tQOPNYs1G8XFxVIa-64" parent="Wy93tQOPNYs1G8XFxVIa-1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" value="Datahub" vertex="1">
          <mxGeometry height="145" width="145" x="160" y="305" as="geometry" />
        </mxCell>
      </root>
