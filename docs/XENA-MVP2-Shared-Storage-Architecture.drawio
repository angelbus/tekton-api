  <diagram id="ahDxGUFceKK6bfe0EDUi" name="XENA MVP2 - Full Architecture">
    <mxGraphModel dx="2194" dy="1178" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-13" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E67E22;strokeWidth=3;dashed=1;" value="" vertex="1">
          <mxGeometry height="430" width="600" x="1430" y="970" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" value="&lt;b&gt;XENA MVP2 - Event-Driven High-Throughput Architecture (833+ processes/min)&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="1200" x="1190" y="170" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-2" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;ARCHITECTURAL PRINCIPLES&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Data Plane = S3 ONLY&lt;br&gt;2. Control Plane = Redis metadata&lt;br&gt;3. Compute Plane = GRID parallel&lt;br&gt;4. Event Plane = SQS decoupling&lt;br&gt;5. Filter Plane = Lambda&lt;br&gt;&lt;br&gt;&lt;b&gt;KEY CHANGES FROM MVP1&lt;/b&gt;&lt;br&gt;✓ Full event-driven (SQS)&lt;br&gt;✓ Book-level processing&lt;br&gt;✓ Parallel deal execution&lt;br&gt;✓ Direct GRID to S3 I/O&lt;br&gt;✓ Output filtering pipeline&lt;br&gt;✓ 833+ processes/minute&lt;br&gt;&lt;br&gt;&lt;b&gt;NO component should:&lt;/b&gt;&lt;br&gt;❌ Store large payloads in memory&lt;br&gt;❌ Block on sync writes&lt;br&gt;❌ Double-buffer data&lt;/font&gt;" vertex="1">
          <mxGeometry height="370" width="300" x="830" y="250" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-3" parent="1" style="text;html=1;strokeColor=#8E44AD;fillColor=#F4ECF7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;SEPARATION OF CONCERNS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;S3&lt;/b&gt; - Storage&lt;br&gt;&lt;b&gt;SQS&lt;/b&gt; - Decoupling&lt;br&gt;&lt;b&gt;Lambda&lt;/b&gt; - Lightweight events&lt;br&gt;&lt;b&gt;FMTMService&lt;/b&gt; - Orchestration&lt;br&gt;&lt;b&gt;GRIDConnector&lt;/b&gt; - Compute bridge&lt;br&gt;&lt;b&gt;MTO GRID&lt;/b&gt; - High-perf calc&lt;br&gt;&lt;b&gt;Redis&lt;/b&gt; - Metadata only&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="300" x="830" y="690" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-4" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;BOOK LIFECYCLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;RECEIVED → QUEUED →&lt;br&gt;PROCESSING → COMPLETED →&lt;br&gt;FILTERED&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure Paths:&lt;/b&gt;&lt;br&gt;PROCESSING → FAILED&lt;br&gt;FILTERING → ERROR_MOVED&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="300" x="830" y="960" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-5" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1F4E78;" value="&lt;b&gt;INGESTION PATH (Book Processing Trigger)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="1170" y="250" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#C0504D;" value="&lt;b&gt;OUTPUT PATH (After Full Book Processed)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="450" x="2090" y="250" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;fontSize=12;" value="&lt;b&gt;Murex / DataLake&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Source of Murex Books (Parquet)" vertex="1">
          <mxGeometry height="100" width="200" x="1170" y="300" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#5D7F0F;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;XENA Input S3 Bucket&lt;/b&gt;&lt;br&gt;[AWS S3]&lt;br&gt;&lt;br&gt;• Full Murex Book (Parquet)&lt;br&gt;• Immutable&lt;br&gt;• Versioning enabled&lt;br&gt;• No listing operations" vertex="1">
          <mxGeometry height="140" width="200" x="1170" y="450" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4B183;strokeColor=#C87137;fontColor=#000000;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;SQS Input Queue&lt;/b&gt;&lt;br&gt;[AWS SQS]&lt;br&gt;&lt;br&gt;• Decouple ingestion&lt;br&gt;• Backpressure control&lt;br&gt;• At-least-once delivery&lt;br&gt;• DLQ enabled&lt;br&gt;• Burst protection" vertex="1">
          <mxGeometry height="140" width="200" x="1170" y="640" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#2E5C9A;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;XENALoader&lt;/b&gt;&lt;br&gt;[Lambda]&lt;br&gt;&lt;br&gt;• Triggered by SQS&lt;br&gt;• Extract metadata&lt;br&gt;• Register Book in Redis&lt;br&gt;• NO download&lt;br&gt;• NO buffering&lt;br&gt;• Lightweight control" vertex="1">
          <mxGeometry height="150" width="200" x="1170" y="830" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A3DD;strokeColor=#0E7DAD;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;AWS API Gateway&lt;/b&gt;&lt;br&gt;[AWS API Gateway]&lt;br&gt;&lt;br&gt;• Controlled entry to EKS&lt;br&gt;• Authentication&lt;br&gt;• Throttling&lt;br&gt;• Observability" vertex="1">
          <mxGeometry height="120" width="200" x="1170" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;strokeColor=#5A8A37;fontColor=#ffffff;align=center;arcSize=10;fontSize=11;" value="&lt;b&gt;SEPIA (NGINX Ingress)&lt;/b&gt;&lt;br&gt;[EKS Ingress]&lt;br&gt;&lt;br&gt;• Routes to services&lt;br&gt;• TLS termination&lt;br&gt;• Internal routing" vertex="1">
          <mxGeometry height="110" width="200" x="1460" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-14" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#E67E22;fontStyle=1" value="&lt;b&gt;EKS Cluster (XENA Namespace)&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="300" x="1450" y="980" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;strokeColor=#5A8A37;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;FMTMService&lt;/b&gt;&lt;br&gt;[EKS Pod]&lt;br&gt;&lt;br&gt;&lt;b&gt;Responsibilities:&lt;/b&gt;&lt;br&gt;• Book-level orchestration&lt;br&gt;• Idempotency enforcement&lt;br&gt;• Redis metadata coordination&lt;br&gt;• Parallel deal scheduling&lt;br&gt;• Completion barrier logic&lt;br&gt;• Business state machine&lt;br&gt;• Operational tracking&lt;br&gt;&lt;br&gt;&lt;b&gt;NOT a pass-through!&lt;/b&gt;" vertex="1">
          <mxGeometry height="190" width="240" x="1740" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#70AD47;strokeColor=#5A8A37;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;GRIDConnector&lt;/b&gt;&lt;br&gt;[EKS Pod]&lt;br&gt;&lt;br&gt;• Technical integration&lt;br&gt;• Start processing request&lt;br&gt;• Does NOT own state&lt;br&gt;• Delegates to GRID" vertex="1">
          <mxGeometry height="110" width="220" x="1750" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A3DD;strokeColor=#0E7DAD;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;Redis (Metadata Only)&lt;/b&gt;&lt;br&gt;[ElastiCache]&lt;br&gt;&lt;br&gt;• Book registration&lt;br&gt;• Idempotency keys&lt;br&gt;• State tracking&lt;br&gt;• Deal coordination&lt;br&gt;• NO payloads!" vertex="1">
          <mxGeometry height="150" width="240" x="1470" y="730" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E67E22;strokeColor=#B85A14;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;fontStyle=1" value="&lt;b&gt;MTO GRID&lt;/b&gt;&lt;br&gt;[C++ Engine - External AWS]&lt;br&gt;&lt;br&gt;&lt;b&gt;CRITICAL:&lt;/b&gt;&lt;br&gt;• Reads Book from S3 DIRECTLY&lt;br&gt;• Splits into Deals internally&lt;br&gt;• Processes in PARALLEL&lt;br&gt;• Writes results DIRECTLY to S3&lt;br&gt;&lt;br&gt;• NO Redis payload storage&lt;br&gt;• NO double-hop via Connector&lt;br&gt;• Cross-account IAM role" vertex="1">
          <mxGeometry height="220" width="300" x="2090" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7AA116;strokeColor=#5D7F0F;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;XENA Output S3 Bucket&lt;/b&gt;&lt;br&gt;[AWS S3]&lt;br&gt;&lt;br&gt;• Calibrated results&lt;br&gt;• Written by GRID directly&lt;br&gt;• Triggers output SQS" vertex="1">
          <mxGeometry height="120" width="220" x="2170" y="820" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4B183;strokeColor=#C87137;fontColor=#000000;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;SQS Output Queue&lt;/b&gt;&lt;br&gt;[AWS SQS]&lt;br&gt;&lt;br&gt;• Decouple result processing&lt;br&gt;• High throughput&lt;br&gt;• Avoid overloading pods" vertex="1">
          <mxGeometry height="110" width="220" x="2160" y="645" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4472C4;strokeColor=#2E5C9A;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;XENAFilter&lt;/b&gt;&lt;br&gt;[Lambda]&lt;br&gt;&lt;br&gt;• Validate output structure&lt;br&gt;• Detect error markers&lt;br&gt;• Move errors to Error bucket&lt;br&gt;• Maintain clean Output&lt;br&gt;&lt;br&gt;• Lightweight&lt;br&gt;• Stateless&lt;br&gt;• Highly parallelizable" vertex="1">
          <mxGeometry height="180" width="220" x="2160" y="410" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C0504D;strokeColor=#984344;fontColor=#ffffff;align=left;arcSize=10;fontSize=11;" value="&lt;b&gt;S3 Error Bucket&lt;/b&gt;&lt;br&gt;[AWS S3]&lt;br&gt;&lt;br&gt;• Invalid results&lt;br&gt;• Error outputs&lt;br&gt;• Isolated from clean data" vertex="1">
          <mxGeometry height="110" width="180" x="1820" y="430" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontColor=#ffffff;align=center;arcSize=10;fontSize=11;" value="&lt;b&gt;Valid Results&lt;/b&gt;&lt;br&gt;Remain in Output Bucket" vertex="1">
          <mxGeometry height="70" width="180" x="1820" y="315" as="geometry" />
        </mxCell>
        <mxCell id="wElA6TZ7euuHoQ-T8m9t-24" edge="1" parent="1" source="wElA6TZ7euuHoQ-T8m9t-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;endArrow=classic;endFill=1;" target="wElA6TZ7euuHoQ-T8m9t-8">
