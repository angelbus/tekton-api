        <mxCell id="file-purposes" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#FEF5E7;font-weight:bold&quot;&gt;&lt;td&gt;File&lt;/td&gt;&lt;td&gt;Purpose&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;_progress.json&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Periodic checkpoint (every 60s or 500 deals)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;manifest.json&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Completion signal (written LAST)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;deals/*.json&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Individual deal results (streaming)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
