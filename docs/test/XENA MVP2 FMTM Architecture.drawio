        <mxCell id="storage-structure" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontFamily=Arial;" value="&lt;b&gt;S3 Storage Layout:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;s3://xena-output-{env}/{bookId}/&lt;br&gt;├── _progress.json&lt;br&gt;├── manifest.json&lt;br&gt;└── deals/&lt;br&gt;    ├── deal_0001.json&lt;br&gt;    ├── deal_0002.json&lt;br&gt;    └── ...&lt;/font&gt;" vertex="1">
