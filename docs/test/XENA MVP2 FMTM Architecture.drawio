        </mxCell>
        <mxCell id="class-retry" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C0504D;fontSize=10;align=left;fontFamily=Courier New;" value="&lt;b&gt;RetryHandler&lt;/b&gt;&lt;hr&gt;&lt;b&gt;Attributes:&lt;/b&gt;&lt;br&gt;- maxRetries: int = 3&lt;br&gt;- baseDelayMs: int = 100&lt;hr&gt;&lt;b&gt;Methods:&lt;/b&gt;&lt;br&gt;+ execute&amp;lt;T&amp;gt;(func: function): T&lt;br&gt;- calculateDelay(retry: int): int&lt;br&gt;- sleep(delayMs: int): void&lt;br&gt;&lt;br&gt;&lt;b&gt;«Pattern»&lt;/b&gt;&lt;br&gt;Exponential Backoff:&lt;br&gt;delay = pow(2, retry) × 100&lt;br&gt;&lt;br&gt;retry1 → 100ms&lt;br&gt;retry2 → 200ms&lt;br&gt;retry3 → 400ms" vertex="1">
