        <mxCell id="legend-processing" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;" value="" vertex="1">
          <mxGeometry height="20" width="30" x="710" y="390" as="geometry" />
        </mxCell>
        <mxCell id="legend-processing-label" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="Processing deals" vertex="1">
          <mxGeometry height="20" width="140" x="750" y="390" as="geometry" />
        </mxCell>
        <mxCell id="legend-idle" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry height="20" width="30" x="710" y="420" as="geometry" />
        </mxCell>
        <mxCell id="legend-idle-label" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="Idle (tail only)" vertex="1">
          <mxGeometry height="20" width="140" x="750" y="420" as="geometry" />
        </mxCell>
        <mxCell id="util-formula" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;fontStyle=0" value="&lt;b&gt;Utilization Formula:&lt;/b&gt;&lt;br&gt;&lt;br&gt;CPU Utilization = (Total Processing Time) / (Total Elapsed Time)&lt;br&gt;&lt;br&gt;≈ 95% for deal-level parallelism&lt;br&gt;vs ~60% for book-level execution" vertex="1">
          <mxGeometry height="130" width="480" x="610" y="470" as="geometry" />
        </mxCell>
        <mxCell id="batch-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="500" width="1140" x="1180" y="130" as="geometry" />
        </mxCell>
        <mxCell id="batch-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#27AE60;" value="&lt;b&gt;Dynamic Batch Size - Solving the Tail Problem&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1100" x="1200" y="145" as="geometry" />
        </mxCell>
        <mxCell id="tail-problem" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;The Tail Problem:&lt;/b&gt;&lt;br&gt;&lt;br&gt;With fixed batch sizes, the last few batches can leave&lt;br&gt;workers idle while others finish large batches.&lt;br&gt;&lt;br&gt;&lt;b&gt;Solution:&lt;/b&gt; Batch size shrinks as queue empties.&lt;br&gt;&lt;br&gt;Heuristic: remainingDeals / workers" vertex="1">
          <mxGeometry height="180" width="480" x="1220" y="200" as="geometry" />
        </mxCell>
        <mxCell id="batch-algo" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;fontFamily=Arial;" value="&lt;b&gt;computeBatchSize() Algorithm:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;size_t computeBatchSize() {&lt;br&gt;    size_t remaining = totalDeals - processedDeals;&lt;br&gt;&lt;br&gt;    if (remaining &amp;gt; 20000)  return 200;&lt;br&gt;    if (remaining &amp;gt; 5000)   return 50;&lt;br&gt;    if (remaining &amp;gt; 1000)   return 10;&lt;br&gt;&lt;br&gt;    return 1;  // Individual deals for tail&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;b&gt;This keeps the system balanced.&lt;/b&gt;" vertex="1">
          <mxGeometry height="200" width="480" x="1220" y="410" as="geometry" />
        </mxCell>
        <mxCell id="graph-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="&lt;b&gt;Batch Size vs Remaining Deals:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="1760" y="200" as="geometry" />
        </mxCell>
        <mxCell id="y-axis" parent="1" style="line;strokeWidth=2;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="300" x="1800" y="250" as="geometry" />
        </mxCell>
        <mxCell id="x-axis" parent="1" style="line;strokeWidth=2;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry width="400" x="1800" y="550" as="geometry" />
        </mxCell>
        <mxCell id="y-label-200" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;" value="200" vertex="1">
          <mxGeometry height="20" width="40" x="1750" y="250" as="geometry" />
        </mxCell>
        <mxCell id="y-label-100" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;" value="100" vertex="1">
          <mxGeometry height="20" width="40" x="1750" y="325" as="geometry" />
        </mxCell>
        <mxCell id="y-label-50" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;" value="50" vertex="1">
          <mxGeometry height="20" width="40" x="1750" y="400" as="geometry" />
        </mxCell>
        <mxCell id="y-label-0" parent="1" style="text;html=1;align=right;verticalAlign=middle;fontSize=10;" value="0" vertex="1">
          <mxGeometry height="20" width="40" x="1750" y="540" as="geometry" />
        </mxCell>
        <mxCell id="x-label-0" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" value="0" vertex="1">
          <mxGeometry height="20" width="40" x="1790" y="560" as="geometry" />
        </mxCell>
        <mxCell id="x-label-5k" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" value="5K" vertex="1">
          <mxGeometry height="20" width="40" x="1900" y="560" as="geometry" />
        </mxCell>
        <mxCell id="x-label-10k" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" value="10K" vertex="1">
          <mxGeometry height="20" width="40" x="2000" y="560" as="geometry" />
        </mxCell>
        <mxCell id="x-label-20k" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" value="20K+" vertex="1">
          <mxGeometry height="20" width="40" x="2160" y="560" as="geometry" />
        </mxCell>
        <mxCell id="y-axis-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;rotation=-90;" value="Batch Size" vertex="1">
          <mxGeometry height="30" width="100" x="1720" y="380" as="geometry" />
        </mxCell>
        <mxCell id="x-axis-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;" value="Remaining Deals" vertex="1">
          <mxGeometry height="30" width="140" x="1950" y="590" as="geometry" />
        </mxCell>
        <mxCell id="line1" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry width="90" x="1800" y="535" as="geometry" />
        </mxCell>
        <mxCell id="line2" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry height="60" x="1890" y="475" as="geometry" />
        </mxCell>
        <mxCell id="line3" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry width="110" x="1890" y="475" as="geometry" />
        </mxCell>
        <mxCell id="line4" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry height="75" x="2000" y="400" as="geometry" />
        </mxCell>
        <mxCell id="line5" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry width="80" x="2000" y="400" as="geometry" />
        </mxCell>
        <mxCell id="line6" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry height="150" x="2080" y="250" as="geometry" />
        </mxCell>
        <mxCell id="line7" parent="1" style="line;strokeWidth=3;strokeColor=#E67E22;" value="" vertex="1">
          <mxGeometry width="120" x="2080" y="250" as="geometry" />
        </mxCell>
        <mxCell id="hetero-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="340" width="1040" x="80" y="660" as="geometry" />
        </mxCell>
        <mxCell id="hetero-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;Handling Heterogeneous Deal Cost&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1000" x="100" y="675" as="geometry" />
        </mxCell>
        <mxCell id="hetero-problem" parent="1" style="text;html=1;strokeColor=#4472C4;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;Challenge:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deals vary widely in processing cost:&lt;br&gt;&lt;br&gt;• Deal A → 0.5s (simple FX forward)&lt;br&gt;• Deal B → 15s (exotic barrier option)&lt;br&gt;• Deal C → 1s (vanilla swap)&lt;br&gt;&lt;br&gt;With static assignment, workers finish&lt;br&gt;at different times → idle workers." vertex="1">
          <mxGeometry height="240" width="480" x="120" y="730" as="geometry" />
        </mxCell>
        <mxCell id="hetero-solution" parent="1" style="text;html=1;strokeColor=#4472C4;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontFamily=Arial;" value="&lt;b&gt;Solution: Dynamic Global Queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fast threads immediately take next work:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;while (GlobalDealQueue.pop(deal)) {&lt;br&gt;    process(deal);&lt;br&gt;    resultQueue.push(result);&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Automatic load balancing&lt;br&gt;&lt;br&gt;No manual partitioning required.&lt;br&gt;Workers self-organize based on actual&lt;br&gt;deal complexity." vertex="1">
          <mxGeometry height="240" width="450" x="640" y="730" as="geometry" />
        </mxCell>
        <mxCell id="hpc-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="430" width="1140" x="1180" y="660" as="geometry" />
        </mxCell>
        <mxCell id="hpc-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#F4B183;" value="&lt;b&gt;HPC-Friendly Design Principles&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1100" x="1200" y="675" as="geometry" />
        </mxCell>
        <mxCell id="hpc-principles" parent="1" style="text;html=1;strokeColor=#F4B183;fillColor=#FFF4E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;This architecture respects HPC principles:&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ &lt;b&gt;Coarse-Grained Orchestration&lt;/b&gt;&lt;br&gt;   Books submitted to GRID, not individual deals&lt;br&gt;   Minimal control-plane overhead&lt;br&gt;&lt;br&gt;✓ &lt;b&gt;Local Scheduling&lt;/b&gt;&lt;br&gt;   GRID workers manage their own queues&lt;br&gt;   No centralized dispatcher bottleneck&lt;br&gt;&lt;br&gt;✓ &lt;b&gt;Dynamic Load Balancing&lt;/b&gt;&lt;br&gt;   Global queue enables automatic work distribution&lt;br&gt;   Adapts to heterogeneous deal costs&lt;br&gt;&lt;br&gt;✓ &lt;b&gt;Minimal Control-Plane Overhead&lt;/b&gt;&lt;br&gt;   Control messages only for job start/completion&lt;br&gt;   Data plane (S3) handles all heavy payloads&lt;br&gt;&lt;br&gt;✓ &lt;b&gt;Deterministic Completion&lt;/b&gt;&lt;br&gt;   manifest.json = atomic completion signal&lt;br&gt;   Zero polling, event-driven notification" vertex="1">
          <mxGeometry height="340" width="520" x="1220" y="730" as="geometry" />
        </mxCell>
        <mxCell id="efficiency-summary" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontStyle=0" value="&lt;b&gt;Efficiency Summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CPU utilization:&lt;/b&gt; near 100%&lt;br&gt;&lt;b&gt;Scheduling overhead:&lt;/b&gt; minimal&lt;br&gt;&lt;b&gt;Network chatter:&lt;/b&gt; minimal&lt;br&gt;&lt;b&gt;Failure recovery:&lt;/b&gt; partial recompute&lt;br&gt;&lt;b&gt;Completion latency:&lt;/b&gt; event-driven&lt;br&gt;&lt;br&gt;&lt;b&gt;Scaling Dimensions:&lt;/b&gt;&lt;br&gt;• Books (independent)&lt;br&gt;• Deals (parallel)&lt;br&gt;• GRID nodes (horizontal)&lt;br&gt;• Threads (vertical)&lt;br&gt;&lt;br&gt;&lt;b&gt;No central bottleneck&lt;/b&gt;" vertex="1">
          <mxGeometry height="340" width="500" x="1780" y="730" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;arcSize=5;fontStyle=0" value="&lt;b&gt;Key Takeaway:&lt;/b&gt; Deal-level parallelism with dynamic batching and global queuing achieves near-optimal CPU utilization while respecting HPC design principles." vertex="1">
          <mxGeometry height="60" width="1040" x="80" y="1030" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b style=&quot;font-weight:normal;&quot; id=&quot;docs-internal-guid-f95784f1-7fff-1646-6b77-1c7acb038a49&quot;&gt;&lt;img width=&quot;496px;&quot; height=&quot;384px;&quot; src=&quot;data:image/png;base64,&quot; alt=&quot;tail_problem_chart.png&quot;&gt;&lt;/b&gt;" link="&lt;b style=&quot;font-weight:normal;&quot; id=&quot;docs-internal-guid-f95784f1-7fff-1646-6b77-1c7acb038a49&quot;&gt;&lt;img width=&quot;496px;&quot; height=&quot;384px;&quot; src=&quot;data:image/png;base64,&quot; alt=&quot;tail_problem_chart.png&quot;&gt;&lt;/b&gt;" id="aqMMsUN2laY8tkLTcoIY-1">
          <mxCell parent="1" style="text;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="410" width="530" x="1761" y="195" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. Payload Contracts &amp; Completion Flow" id="tbxq_GmuudyaeUvPhCt2">
    <mxGraphModel dx="1426" dy="766" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="payload-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1" value="&lt;b&gt;GRID XDE - Payload Contracts &amp;amp; Completion Flow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Zero Polling, Event-Driven, Deterministic Completion&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="2000" x="200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="payload-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D6E4F5;strokeColor=#5B9BD5;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="620" width="1100" x="80" y="130" as="geometry" />
        </mxCell>
        <mxCell id="payload-header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#5B9BD5;" value="&lt;b&gt;1. Payload Delivery (Job Initialization)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1060" x="100" y="145" as="geometry" />
        </mxCell>
        <mxCell id="payload-desc" parent="1" style="text;html=1;strokeColor=#5B9BD5;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;Payload arrives at job start&lt;/b&gt; (sent by GRIDConnector):&lt;br&gt;&lt;br&gt;Avoids:&lt;br&gt;• Duplicate metadata reads&lt;br&gt;• Slower startup&lt;br&gt;• Non-deterministic initialization&lt;br&gt;&lt;br&gt;Enables:&lt;br&gt;• Dynamic observability and monitoring&lt;br&gt;• Fast startup&lt;br&gt;• Deterministic progress tracking" vertex="1">
          <mxGeometry height="220" width="480" x="120" y="200" as="geometry" />
        </mxCell>
        <mxCell id="payload-json-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="&lt;b&gt;Payload Structure:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="200" x="640" y="200" as="geometry" />
        </mxCell>
        <mxCell id="payload-json" parent="1" style="text;html=1;strokeColor=#5B9BD5;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontFamily=Arial;" value="&lt;font face=&quot;Courier New&quot;&gt;{&lt;br&gt;  &quot;jobId&quot;: &quot;uuid-12345&quot;,&lt;br&gt;  &quot;bookId&quot;: &quot;eFX&quot;,&lt;br&gt;  &quot;valuationDate&quot;: &quot;2026-03-07&quot;,&lt;br&gt;&lt;br&gt;  &quot;inputFile&quot;: &quot;s3://xena-input-{env}/{bookId}/book.parquet&quot;,&lt;br&gt;  &quot;resultsPath&quot;: &quot;s3://xena-output-{env}/{bookId}/&quot;,&lt;br&gt;  &quot;errorPath&quot;: &quot;s3://xena-error-{env}/{bookId}/&quot;,&lt;br&gt;&lt;br&gt;  &quot;totalDeals&quot;: 825734,&lt;br&gt;  &quot;bookSizeBytes&quot;: 4387239842,&lt;br&gt;&lt;br&gt;  &quot;reconciliation&quot;: false,&lt;br&gt;  &quot;bookRetries&quot;: 0,&lt;br&gt;  &quot;etaSeconds&quot;: 180&lt;br&gt;}&lt;/font&gt;" vertex="1">
          <mxGeometry height="310" width="510" x="640" y="240" as="geometry" />
        </mxCell>
        <mxCell id="field-table-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="&lt;b&gt;Field Purposes:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="200" x="120" y="450" as="geometry" />
        </mxCell>
        <mxCell id="field-table" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; style=&quot;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#E7F3FF;font-weight:bold&quot;&gt;&lt;td&gt;Field&lt;/td&gt;&lt;td&gt;Purpose&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;totalDeals&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Initialize progress tracking&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;bookSizeBytes&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Monitoring + scheduling&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;reconciliation&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Partial recompute mode&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;bookRetries&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Reconciliation attempts&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;etaSeconds&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Expected time to complete&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="230" width="480" x="120" y="490" as="geometry" />
        </mxCell>
        <mxCell id="progress-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="620" width="1080" x="1240" y="130" as="geometry" />
        </mxCell>
        <mxCell id="progress-header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#F4B183;" value="&lt;b&gt;2. Progress Tracking (_progress.json)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1040" x="1260" y="145" as="geometry" />
        </mxCell>
        <mxCell id="progress-desc" parent="1" style="text;html=1;strokeColor=#F4B183;fillColor=#FFF4E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;XDE writes progress periodically:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Every 60 seconds (configurable)&lt;br&gt;• Every 500 deals (configurable)&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt;&lt;br&gt;• High observability and monitoring&lt;br&gt;• Reconciliation detection&lt;br&gt;• Recovery insight&lt;br&gt;• ETA calculation" vertex="1">
          <mxGeometry height="220" width="400" x="1280" y="200" as="geometry" />
        </mxCell>
        <mxCell id="progress-json-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="&lt;b&gt;_progress.json Structure:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="250" x="1720" y="200" as="geometry" />
        </mxCell>
        <mxCell id="progress-json" parent="1" style="text;html=1;strokeColor=#F4B183;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontFamily=Arial;" value="&lt;font face=&quot;Courier New&quot;&gt;{&lt;br&gt;  &quot;bookId&quot;: &quot;eFX&quot;,&lt;br&gt;  &quot;inputFile&quot;: &quot;s3://xena-input/eFX/book.parquet&quot;,&lt;br&gt;&lt;br&gt;  &quot;totalDeals&quot;: 48178,&lt;br&gt;  &quot;processedDeals&quot;: 17842,&lt;br&gt;  &quot;completedDeals&quot;: 17000,&lt;br&gt;  &quot;failedDeals&quot;: 842,&lt;br&gt;&lt;br&gt;  &quot;lastProcessingDeal&quot;: &quot;deal-918273&quot;,&lt;br&gt;&lt;br&gt;  &quot;processingRateDealsPerSec&quot;: 145,&lt;br&gt;  &quot;estimatedCompletionSeconds&quot;: 210,&lt;br&gt;&lt;br&gt;  &quot;bookRetries&quot;: 1,&lt;br&gt;&lt;br&gt;  &quot;startTime&quot;: &quot;2026-03-05T18:00:12Z&quot;,&lt;br&gt;  &quot;lastUpdate&quot;: &quot;2026-03-05T18:42:11Z&quot;,&lt;br&gt;&lt;br&gt;  &quot;gridJobId&quot;: &quot;grid-742912&quot;,&lt;br&gt;  &quot;version&quot;: &quot;1.0&quot;&lt;br&gt;}&lt;/font&gt;" vertex="1">
          <mxGeometry height="430" width="560" x="1720" y="240" as="geometry" />
        </mxCell>
        <mxCell id="progress-uses" parent="1" style="text;html=1;strokeColor=#F4B183;fillColor=#FFF4E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;" value="&lt;b&gt;Key Use Cases:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Monitoring&lt;/b&gt;&lt;br&gt;   XENA reads progress to show dashboard&lt;br&gt;&lt;br&gt;2. &lt;b&gt;Stall Detection&lt;/b&gt;&lt;br&gt;   If lastUpdate &amp;gt; 10 min ago → stalled&lt;br&gt;&lt;br&gt;3. &lt;b&gt;ETA Calculation&lt;/b&gt;&lt;br&gt;   remaining / processingRate = ETA&lt;br&gt;&lt;br&gt;4. &lt;b&gt;Recovery Decisions&lt;/b&gt;&lt;br&gt;   Determine which deals to reprocess" vertex="1">
          <mxGeometry height="270" width="400" x="1280" y="450" as="geometry" />
        </mxCell>
        <mxCell id="recon-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="380" width="1100" x="80" y="800" as="geometry" />
        </mxCell>
        <mxCell id="recon-header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;3. Failure and Recovery (Reconciliation Mode)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1060" x="100" y="815" as="geometry" />
        </mxCell>
        <mxCell id="recon-desc" parent="1" style="text;html=1;strokeColor=#4472C4;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;fontFamily=Arial;" value="&lt;b&gt;When book fails or stalls:&lt;/b&gt;&lt;br&gt;Payload sent with:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;{&lt;br&gt;  &quot;reconciliation&quot;: true,&lt;br&gt;  &quot;bookRetries&quot;: 1&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;XDE Logic:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;if (job.reconciliation) {&lt;br&gt;    for (auto&amp;amp; deal : book.deals) {&lt;br&gt;        if (resultExists(deal.dealId)) {&lt;br&gt;            skip;  // Already processed&lt;br&gt;        } else {&lt;br&gt;            process(deal);&lt;br&gt;        }&lt;br&gt;    }&lt;br&gt;}&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="480" x="120" y="870" as="geometry" />
        </mxCell>
        <mxCell id="recon-benefits" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;arcSize=5;fontStyle=0" value="&lt;b&gt;Result: Partial Recomputation Only&lt;/b&gt;&lt;br&gt;&lt;br&gt;This dramatically reduces recovery time.&lt;br&gt;&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt;&lt;br&gt;• Book has 100,000 deals&lt;br&gt;• 95,000 succeeded before failure&lt;br&gt;• 5,000 failed or missing&lt;br&gt;&lt;br&gt;Reconciliation:&lt;br&gt;• Checks S3 for existing results&lt;br&gt;• Skips 95,000 deals (already done)&lt;br&gt;• Processes only 5,000 missing deals&lt;br&gt;&lt;br&gt;&lt;b&gt;Recovery Time:&lt;/b&gt;&lt;br&gt;• Without reconciliation: ~10 minutes (full book)&lt;br&gt;• With reconciliation: ~30 seconds (5% of deals)&lt;br&gt;&lt;br&gt;&lt;b&gt;20x faster recovery!&lt;/b&gt;" vertex="1">
          <mxGeometry height="280" width="510" x="640" y="870" as="geometry" />
        </mxCell>
        <mxCell id="completion-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="650" width="1080" x="1240" y="800" as="geometry" />
        </mxCell>
        <mxCell id="completion-header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#27AE60;" value="&lt;b&gt;4. Completion Notification (manifest.json)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1040" x="1260" y="815" as="geometry" />
        </mxCell>
        <mxCell id="completion-contract" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;Completion Contract:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px;color:#27AE60&quot;&gt;manifest.json written LAST&lt;/b&gt;&lt;br&gt;&lt;br&gt;This file signals job finished.&lt;br&gt;&lt;br&gt;&lt;b&gt;S3 Event Configuration:&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;suffix = manifest.json&lt;/font&gt;&lt;br&gt;&lt;br&gt;Triggers XENAOutput Lambda.&lt;br&gt;&lt;br&gt;&lt;b&gt;Benefits:&lt;/b&gt;&lt;br&gt;• Zero polling&lt;br&gt;• Deterministic completion&lt;br&gt;• Minimal latency&lt;br&gt;• Event-driven architecture" vertex="1">
          <mxGeometry height="320" width="440" x="1280" y="870" as="geometry" />
        </mxCell>
        <mxCell id="manifest-json-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" value="&lt;b&gt;manifest.json Structure:&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="250" x="1860" y="870" as="geometry" />
        </mxCell>
        <mxCell id="manifest-json" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontFamily=Arial;" value="&lt;font face=&quot;Courier New&quot;&gt;{&lt;br&gt;  &quot;bookId&quot;: &quot;eFX&quot;,&lt;br&gt;  &quot;inputFile&quot;: &quot;s3://xena-input/eFX/book.parquet&quot;,&lt;br&gt;&lt;br&gt;  &quot;totalDeals&quot;: 48178,&lt;br&gt;  &quot;completedDeals&quot;: 47000,&lt;br&gt;  &quot;failedDeals&quot;: 1178,&lt;br&gt;&lt;br&gt;  &quot;status&quot;: &quot;COMPLETED&quot;,&lt;br&gt;  &quot;totalRetries&quot;: 0,&lt;br&gt;&lt;br&gt;  &quot;startTime&quot;: &quot;2026-03-05T18:00:12Z&quot;,&lt;br&gt;  &quot;endTime&quot;: &quot;2026-03-05T18:07:42Z&quot;,&lt;br&gt;  &quot;durationSeconds&quot;: 450,&lt;br&gt;&lt;br&gt;  &quot;resultsPath&quot;: &quot;s3://xena-output/eFX/&quot;,&lt;br&gt;  &quot;errorPath&quot;: &quot;s3://xena-error/eFX/&quot;,&lt;br&gt;&lt;br&gt;  &quot;gridJobId&quot;: &quot;grid-742912&quot;,&lt;br&gt;  &quot;version&quot;: &quot;1.0&quot;&lt;br&gt;}&lt;/font&gt;" vertex="1">
          <mxGeometry height="430" width="420" x="1860" y="910" as="geometry" />
