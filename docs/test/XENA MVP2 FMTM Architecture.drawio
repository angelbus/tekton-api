        <mxCell id="lifecycle-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;Book Lifecycle in Redis&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1120" x="140" y="555" as="geometry" />
        </mxCell>
        <mxCell id="lc-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F5;strokeColor=#5B9BD5;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;1. Book Submitted&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Create book:{bookId} hash&lt;br&gt;• Set status = QUEUED&lt;br&gt;• Add to pendingBooks set" vertex="1">
