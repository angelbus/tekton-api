        <mxCell id="xde-container" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E67E22;strokeWidth=4;dashed=1;" value="" vertex="1">
          <mxGeometry height="1315" width="1600" x="400" y="125" as="geometry" />
        </mxCell>
        <mxCell id="xde-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#E67E22;fontStyle=1" value="&lt;b&gt;XDE Engine Container [C++]&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="400" x="420" y="140" as="geometry" />
        </mxCell>
        <mxCell id="comp-engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#E67E22;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;XDEEngine Core&lt;/b&gt;&lt;br&gt;[Main Orchestrator]&lt;br&gt;&lt;br&gt;&lt;b&gt;State Machine:&lt;/b&gt;&lt;br&gt;INITIALIZED → BOOK_LOADING&lt;br&gt;→ DEAL_STREAMING&lt;br&gt;→ DEAL_PROCESSING&lt;br&gt;→ RESULT_AGGREGATION&lt;br&gt;→ MANIFEST_GENERATION&lt;br&gt;→ COMPLETED&lt;br&gt;&lt;br&gt;&lt;b&gt;Atomic Counters:&lt;/b&gt;&lt;br&gt;• totalDeals&lt;br&gt;• processedDeals&lt;br&gt;• completedDeals&lt;br&gt;• failedDeals" vertex="1">
          <mxGeometry height="320" width="280" x="440" y="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-reader" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Parquet Streaming Reader&lt;/b&gt;&lt;br&gt;[Chunked Reader]&lt;br&gt;&lt;br&gt;&lt;b&gt;Constraint:&lt;/b&gt;&lt;br&gt;❌ Never load full book&lt;br&gt;✅ Streaming records&lt;br&gt;✅ Bounded memory&lt;br&gt;&lt;br&gt;&lt;b&gt;Methods:&lt;/b&gt;&lt;br&gt;• hasNext()&lt;br&gt;• nextDeal()&lt;br&gt;• readChunk()" vertex="1">
          <mxGeometry height="200" width="280" x="440" y="560" as="geometry" />
        </mxCell>
        <mxCell id="comp-batcher" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Dynamic Batch Optimizer&lt;/b&gt;&lt;br&gt;[Adaptive Sizing]&lt;br&gt;&lt;br&gt;&lt;b&gt;Logic:&lt;/b&gt;&lt;br&gt;remaining &amp;gt; 20K → batch=200&lt;br&gt;remaining &amp;gt; 5K → batch=50&lt;br&gt;remaining &amp;gt; 1K → batch=10&lt;br&gt;else → batch=1&lt;br&gt;&lt;br&gt;&lt;b&gt;Goal:&lt;/b&gt; 99% utilization&lt;br&gt;Avoid tail latency" vertex="1">
          <mxGeometry height="220" width="260" x="760" y="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-recon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Reconciliation Logic&lt;/b&gt;&lt;br&gt;[Idempotency Check]&lt;br&gt;&lt;br&gt;&lt;b&gt;When reconciliation=true:&lt;/b&gt;&lt;br&gt;• Increment bookRetries&lt;br&gt;• Check S3 for existing results&lt;br&gt;• Skip deals already processed&lt;br&gt;&lt;br&gt;&lt;b&gt;Method:&lt;/b&gt;&lt;br&gt;resultExistsInS3(dealId)&lt;br&gt;&lt;br&gt;&lt;b&gt;Stateless:&lt;/b&gt; No Redis needed" vertex="1">
          <mxGeometry height="220" width="260" x="760" y="460" as="geometry" />
        </mxCell>
        <mxCell id="comp-dealqueue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F5;strokeColor=#5B9BD5;fontSize=11;align=left;fontStyle=1" value="&lt;b&gt;Deal Queue&lt;/b&gt;&lt;br&gt;[Concurrent Queue]&lt;br&gt;&lt;br&gt;ConcurrentQueue&amp;lt;DealBatch&amp;gt;&lt;br&gt;&lt;br&gt;Thread-safe&lt;br&gt;Lock-free&lt;br&gt;Producer: Reader&lt;br&gt;Consumers: Workers" vertex="1">
          <mxGeometry height="160" width="240" x="1060" y="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-workers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#E67E22;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Worker Thread Pool&lt;/b&gt;&lt;br&gt;[CPU-Bound Processing]&lt;br&gt;&lt;br&gt;&lt;b&gt;Count:&lt;/b&gt; 2 × CPU cores&lt;br&gt;&lt;br&gt;&lt;b&gt;Tasks:&lt;/b&gt;&lt;br&gt;• Pop DealBatch from queue&lt;br&gt;• Process each deal&lt;br&gt;• Compute FMTM cube&lt;br&gt;• Push Result to resultQueue&lt;br&gt;&lt;br&gt;&lt;b&gt;Retry Logic:&lt;/b&gt;&lt;br&gt;• Max retries: 3&lt;br&gt;• Exponential backoff:&lt;br&gt;  100ms, 200ms, 400ms&lt;br&gt;&lt;br&gt;&lt;b&gt;Error Handling:&lt;/b&gt;&lt;br&gt;Catch exceptions → mark failed" vertex="1">
          <mxGeometry height="360" width="240" x="1060" y="400" as="geometry" />
        </mxCell>
        <mxCell id="comp-resultqueue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F5;strokeColor=#5B9BD5;fontSize=11;align=left;fontStyle=1" value="&lt;b&gt;Result Queue&lt;/b&gt;&lt;br&gt;[Concurrent Queue]&lt;br&gt;&lt;br&gt;ConcurrentQueue&amp;lt;Result&amp;gt;&lt;br&gt;&lt;br&gt;Thread-safe&lt;br&gt;Producers: Workers&lt;br&gt;Consumer: Aggregator" vertex="1">
          <mxGeometry height="140" width="240" x="1340" y="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-aggregator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Aggregator Thread&lt;/b&gt;&lt;br&gt;[Single Thread - Coordination]&lt;br&gt;&lt;br&gt;&lt;b&gt;Tasks:&lt;/b&gt;&lt;br&gt;• Pop Result from resultQueue&lt;br&gt;• Update atomic counters:&lt;br&gt;  - processedDeals++&lt;br&gt;  - completedDeals++ (if success)&lt;br&gt;  - failedDeals++ (if failed)&lt;br&gt;• Update lastProcessingDeal&lt;br&gt;• Push to writeQueue&lt;br&gt;&lt;br&gt;&lt;b&gt;Progress Writing:&lt;/b&gt;&lt;br&gt;• Every 10 minutes (MAX)&lt;br&gt;• Every 500 deals&lt;br&gt;• Write _progress.json&lt;br&gt;• Calculate ETA&lt;br&gt;&lt;br&gt;&lt;b&gt;Completion Check:&lt;/b&gt;&lt;br&gt;processedDeals == totalDeals" vertex="1">
          <mxGeometry height="380" width="240" x="1340" y="380" as="geometry" />
        </mxCell>
        <mxCell id="comp-writequeue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F5;strokeColor=#5B9BD5;fontSize=11;align=left;fontStyle=1" value="&lt;b&gt;Write Queue&lt;/b&gt;&lt;br&gt;[Concurrent Queue]&lt;br&gt;&lt;br&gt;ConcurrentQueue&amp;lt;Result&amp;gt;&lt;br&gt;&lt;br&gt;Thread-safe&lt;br&gt;Producer: Aggregator&lt;br&gt;Consumers: S3 Writers" vertex="1">
          <mxGeometry height="140" width="240" x="1620" y="200" as="geometry" />
        </mxCell>
        <mxCell id="comp-writers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;S3 Writer Thread Pool&lt;/b&gt;&lt;br&gt;[IO-Bound Processing]&lt;br&gt;&lt;br&gt;&lt;b&gt;Count:&lt;/b&gt; 4 threads&lt;br&gt;&lt;br&gt;&lt;b&gt;Tasks:&lt;/b&gt;&lt;br&gt;• Pop Result from writeQueue&lt;br&gt;• if success:&lt;br&gt;  → uploadResult() to Output&lt;br&gt;• if failed:&lt;br&gt;  → uploadError() to Error&lt;br&gt;&lt;br&gt;&lt;b&gt;Files Written:&lt;/b&gt;&lt;br&gt;• deal_{dealId}.parquet&lt;br&gt;• deal_{dealId}.json (errors)&lt;br&gt;&lt;br&gt;&lt;b&gt;Parallel Upload:&lt;/b&gt;&lt;br&gt;High throughput" vertex="1">
          <mxGeometry height="320" width="240" x="1620" y="380" as="geometry" />
        </mxCell>
        <mxCell id="comp-progress" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#F4B183;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Progress Writer&lt;/b&gt;&lt;br&gt;[Telemetry Component]&lt;br&gt;&lt;br&gt;&lt;b&gt;File:&lt;/b&gt; _progress.json&lt;br&gt;&lt;br&gt;&lt;b&gt;Contains:&lt;/b&gt;&lt;br&gt;• bookId&lt;br&gt;• totalDeals&lt;br&gt;• processedDeals&lt;br&gt;• completedDeals&lt;br&gt;• failedDeals&lt;br&gt;• lastProcessingDeal&lt;br&gt;• processingRateDealsPerSec&lt;br&gt;• estimatedCompletionSeconds&lt;br&gt;• lastUpdate (timestamp)&lt;br&gt;&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt;&lt;br&gt;Enable reconciliation detection" vertex="1">
          <mxGeometry height="340" width="280" x="440" y="820" as="geometry" />
        </mxCell>
        <mxCell id="comp-manifest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontColor=#FFFFFF;fontSize=11;align=left;fontStyle=1" value="&lt;b&gt;Manifest Writer&lt;/b&gt;&lt;br&gt;[Completion Signal]&lt;br&gt;&lt;br&gt;&lt;b&gt;File:&lt;/b&gt; manifest.json&lt;br&gt;&lt;br&gt;&lt;b&gt;Condition:&lt;/b&gt;&lt;br&gt;completedDeals + failedDeals&lt;br&gt;== totalDeals&lt;br&gt;&lt;br&gt;&lt;b&gt;Contains:&lt;/b&gt;&lt;br&gt;• bookId&lt;br&gt;• totalDeals&lt;br&gt;• completedDeals&lt;br&gt;• failedDeals&lt;br&gt;• status (COMPLETED)&lt;br&gt;• startTime, endTime&lt;br&gt;• durationSeconds&lt;br&gt;• resultsPath, errorPath&lt;br&gt;• gridJobId&lt;br&gt;&lt;br&gt;&lt;b&gt;Triggers XENA completion&lt;/b&gt;" vertex="1">
          <mxGeometry height="340" width="260" x="760" y="820" as="geometry" />
        </mxCell>
        <mxCell id="comp-retry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C0504D;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Retry Handler&lt;/b&gt;&lt;br&gt;[Exponential Backoff]&lt;br&gt;&lt;br&gt;&lt;b&gt;Logic:&lt;/b&gt;&lt;br&gt;processDealWithRetry()&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuration:&lt;/b&gt;&lt;br&gt;• maxRetries = 3&lt;br&gt;• Base delay = 100ms&lt;br&gt;&lt;br&gt;&lt;b&gt;Backoff:&lt;/b&gt;&lt;br&gt;retry 1 → 100ms&lt;br&gt;retry 2 → 200ms&lt;br&gt;retry 3 → 400ms&lt;br&gt;&lt;br&gt;&lt;b&gt;Calculation:&lt;/b&gt;&lt;br&gt;delay = pow(2, retry) × 100&lt;br&gt;&lt;br&gt;After max: throw exception" vertex="1">
          <mxGeometry height="340" width="240" x="1060" y="820" as="geometry" />
        </mxCell>
        <mxCell id="comp-threadmgr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Thread Pool Manager&lt;/b&gt;&lt;br&gt;[Resource Allocation]&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuration:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Workers:&lt;br&gt;  std::thread::hardware_&lt;br&gt;  concurrency() × 2&lt;br&gt;&lt;br&gt;Aggregator:&lt;br&gt;  1 thread (single)&lt;br&gt;&lt;br&gt;S3 Writers:&lt;br&gt;  4 threads (IO-bound)&lt;br&gt;&lt;br&gt;&lt;b&gt;Total Threads:&lt;/b&gt;&lt;br&gt;~17 on 8-core machine" vertex="1">
          <mxGeometry height="280" width="240" x="1340" y="820" as="geometry" />
        </mxCell>
        <mxCell id="comp-error" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C0504D;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;Error Handler&lt;/b&gt;&lt;br&gt;[Exception Management]&lt;br&gt;&lt;br&gt;&lt;b&gt;Strategy:&lt;/b&gt;&lt;br&gt;• Catch all exceptions in workers&lt;br&gt;• Mark result as failed&lt;br&gt;• Continue processing&lt;br&gt;• No job termination&lt;br&gt;&lt;br&gt;&lt;b&gt;Error Output:&lt;/b&gt;&lt;br&gt;Write to S3 Error bucket&lt;br&gt;&lt;br&gt;&lt;b&gt;Partial Success:&lt;/b&gt;&lt;br&gt;Acceptable pattern" vertex="1">
          <mxGeometry height="240" width="240" x="1620" y="820" as="geometry" />
        </mxCell>
