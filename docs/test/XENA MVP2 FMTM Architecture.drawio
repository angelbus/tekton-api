        <mxCell id="details-box" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;KEY CHARACTERISTICS&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Streaming execution (no full memory load)&lt;br&gt;✓ Bounded memory usage&lt;br&gt;✓ Parallel deal processing (~95% utilization)&lt;br&gt;✓ Incremental S3 writes (deal results)&lt;br&gt;✓ Progress tracking (_progress.json every 10&#39;)&lt;br&gt;✓ Completion barrier (all deals finished)&lt;br&gt;✓ Manifest as authoritative signal&lt;/font&gt;" vertex="1">
          <mxGeometry height="220" width="300" x="150" y="130" as="geometry" />
        </mxCell>
