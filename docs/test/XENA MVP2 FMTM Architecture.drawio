        <mxCell id="4319vqAxzSvNMvWEyT58-94" parent="1" style="text;html=1;strokeColor=#5B9BD5;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#E67E22&quot;&gt;━━━━&lt;/b&gt; Data Plane (Heavy payload)&lt;br&gt;&lt;b style=&quot;color:#000000&quot;&gt;━━━━&lt;/b&gt; Control Plane&lt;br&gt;&lt;b style=&quot;color:#F4B183&quot;&gt;- - - -&lt;/b&gt; Event notifications" vertex="1">
          <mxGeometry height="120" width="320" x="480" y="790" as="geometry" />
        </mxCell>
        <mxCell id="4319vqAxzSvNMvWEyT58-95" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;fontStyle=1" value="&lt;b&gt;KEY ARCHITECTURAL PRINCIPLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;🎯 S3 is the shared data plane&lt;br&gt;🎯 XENA does NOT fetch from GRID&lt;br&gt;🎯 GRID does NOT push payloads through Redis&lt;br&gt;🎯 All heavy payloads move directly between compute and S3&lt;br&gt;🎯 XENA reacts to storage events&lt;br&gt;&lt;br&gt;&lt;b&gt;This is NOT:&lt;/b&gt; Service → Service → Redis → Service&lt;br&gt;&lt;b&gt;This IS:&lt;/b&gt; Compute ↔ Shared Storage ↔ Event System" vertex="1">
          <mxGeometry height="220" width="620" x="480" y="950" as="geometry" />
        </mxCell>
        <mxCell id="4319vqAxzSvNMvWEyT58-96" edge="1" parent="1" source="4319vqAxzSvNMvWEyT58-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=classic;endFill=1;strokeColor=#D6B656;dashed=1;entryX=0.414;entryY=0.978;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="4319vqAxzSvNMvWEyT58-53">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2726" y="955" />
            </Array>
            <mxPoint x="2020" y="810" as="sourcePoint" />
            <mxPoint x="2990" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="4319vqAxzSvNMvWEyT58-97" connectable="0" parent="4319vqAxzSvNMvWEyT58-96" style="edgeLabel;html=1;align=center;verticalAlign=top;resizable=0;points=[];fontSize=9;backgroundColor=#FFFFFF;" value="Update GRID Job/Task ID&lt;br&gt;for current BookId request" vertex="1">
