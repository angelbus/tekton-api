        <mxCell id="storage-header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#E67E22;" value="&lt;b&gt;5. Storage Layout and Contracts&lt;/b&gt;" vertex="1">
