        <mxCell id="comp-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1" value="&lt;b&gt;XDE C++ Engine - Complete Component Architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Distributed Compute Engine with Streaming, Dynamic Batching, and Reconciliation&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="2000" x="200" y="20" as="geometry" />
