        <mxCell id="ext-input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F3FF;strokeColor=#4472C4;fontSize=12;align=left;fontStyle=1" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;GRIDConnector Payload&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;JSON with:&lt;br&gt;• bookId&lt;br&gt;• inputFile (S3)&lt;br&gt;• outputPrefix&lt;br&gt;• errorPrefix&lt;br&gt;• reconciliation flag&lt;br&gt;• bookRetries" vertex="1">
