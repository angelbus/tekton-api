        <mxCell id="perf-box" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;PERFORMANCE CHARACTERISTICS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cluster Utilization:&lt;/b&gt; ~95%&lt;br&gt;&lt;b&gt;Memory:&lt;/b&gt; Bounded (streaming)&lt;br&gt;&lt;b&gt;Throughput:&lt;/b&gt; 833+ books/min&lt;br&gt;&lt;b&gt;Parallelism:&lt;/b&gt; 2 × CPU cores&lt;br&gt;&lt;b&gt;Deal Rate:&lt;/b&gt; ~145 deals/sec&lt;br&gt;&lt;b&gt;Retry Overhead:&lt;/b&gt; Minimal&lt;br&gt;&lt;b&gt;Progress Overhead:&lt;/b&gt; &amp;lt;1%&lt;br&gt;&lt;b&gt;Fault Tolerance:&lt;/b&gt; Deal-level" vertex="1">
