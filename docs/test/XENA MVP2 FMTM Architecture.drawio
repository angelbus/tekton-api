        <mxCell id="notes-box" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;b&gt;DESIGN PATTERNS APPLIED&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Producer-Consumer (Queues)&lt;br&gt;✓ Thread Pool Pattern&lt;br&gt;✓ State Machine Pattern&lt;br&gt;✓ Retry with Exponential Backoff&lt;br&gt;✓ Iterator/Streaming Pattern&lt;br&gt;✓ Aggregator Pattern&lt;br&gt;✓ Idempotency Check&lt;br&gt;✓ Template Method&lt;br&gt;✓ Strategy Pattern (Reconciliation)&lt;br&gt;✓ Lock-Free Data Structures&lt;br&gt;✓ Atomic Operations" vertex="1">
          <mxGeometry height="210" width="300" x="100" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="threadsafe-box" parent="1" style="text;html=1;strokeColor=#4472C4;fillColor=#E7F3FF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;b&gt;THREAD SAFETY MECHANISMS&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ ConcurrentQueue (lock-free)&lt;br&gt;✓ Atomic counters (std::atomic)&lt;br&gt;✓ Mutex protection (queue internals)&lt;br&gt;✓ Condition variables (blocking pop)&lt;br&gt;✓ Thread-local storage (workers)&lt;br&gt;✓ Immutable data passing&lt;br&gt;✓ Single writer per counter&lt;br&gt;✓ Memory barriers (atomic ops)" vertex="1">
          <mxGeometry height="210" width="300" x="460" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="performance-box" parent="1" style="text;html=1;strokeColor=#27AE60;fillColor=#E8F8F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;b&gt;PERFORMANCE OPTIMIZATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Dynamic batch sizing (99% utilization)&lt;br&gt;✓ Streaming (bounded memory)&lt;br&gt;✓ Lock-free queues (no contention)&lt;br&gt;✓ Parallel I/O (4 S3 writers)&lt;br&gt;✓ Worker count = 2 × cores&lt;br&gt;✓ Progress writes: max 10min interval&lt;br&gt;✓ Zero-copy data structures&lt;br&gt;✓ Minimal synchronization points" vertex="1">
          <mxGeometry height="150" width="340" x="800" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="reliability-box" parent="1" style="text;html=1;strokeColor=#C0504D;fillColor=#FFE6E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;b&gt;RELIABILITY FEATURES&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Retry with exponential backoff&lt;br&gt;✓ Deal-level fault isolation&lt;br&gt;✓ Partial failure tolerance&lt;br&gt;✓ Idempotent S3 checks&lt;br&gt;✓ Stateless reconciliation&lt;br&gt;✓ Progress monitoring (ETA)&lt;br&gt;✓ Completion barrier&lt;br&gt;✓ Atomic state transitions&lt;br&gt;✓ Exception handling per worker" vertex="1">
          <mxGeometry height="190" width="340" x="1240" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="memory-box" parent="1" style="text;html=1;strokeColor=#F4B183;fillColor=#FFF4E6;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;" value="&lt;b&gt;MEMORY MODEL&lt;/b&gt;&lt;br&gt;&lt;br&gt;✓ Bounded memory usage&lt;br&gt;✓ No full book materialization&lt;br&gt;✓ Streaming Parquet reads&lt;br&gt;✓ Move semantics (zero-copy)&lt;br&gt;✓ RAII resource management&lt;br&gt;✓ Smart pointers where needed&lt;br&gt;✓ Stack allocation preferred&lt;br&gt;✓ Cache-friendly data layouts" vertex="1">
          <mxGeometry height="195" width="320" x="1660" y="1215" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. XDE Architectural Principles" id="SnySA7bqvTgzVD4EqwkJ">
    <mxGraphModel dx="2037" dy="1094" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1" value="&lt;b&gt;GRID XDE - Architectural Principles &amp;amp; Performance Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;HPC-Friendly Design for Maximum CPU Utilization and Minimal Latency&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="2000" x="200" y="20" as="geometry" />
        </mxCell>
        <mxCell id="cpu-box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#E67E22;strokeWidth=3;" value="" vertex="1">
          <mxGeometry height="500" width="1040" x="80" y="130" as="geometry" />
        </mxCell>
        <mxCell id="cpu-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#E67E22;" value="&lt;b&gt;Why CPU Utilization is Maximized (~95%)&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="1000" x="100" y="145" as="geometry" />
        </mxCell>
        <mxCell id="math-model" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=13;arcSize=5;" value="&lt;b&gt;Mathematical Model:&lt;/b&gt;&lt;br&gt;&lt;br&gt;BOOK = orchestration unit&lt;br&gt;DEAL = compute unit&lt;br&gt;&lt;br&gt;Given:&lt;br&gt;• N = worker threads&lt;br&gt;• M = total deals in book&lt;br&gt;&lt;br&gt;Workers execute:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;while (GlobalDealQueue.pop(deal)) {&lt;br&gt;    process(deal);&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt;&lt;br&gt;CPU utilization ≈ 100% until queue empty&lt;br&gt;&lt;br&gt;Idle time occurs only at the very end (tail)" vertex="1">
          <mxGeometry height="400" width="450" x="120" y="200" as="geometry" />
        </mxCell>
