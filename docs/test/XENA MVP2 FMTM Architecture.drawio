        <mxCell id="ext-s3-error" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6E6;strokeColor=#C0504D;fontSize=12;align=left;fontStyle=1" value="&lt;b&gt;S3 Error Bucket&lt;/b&gt;&lt;br&gt;&lt;br&gt;• deal_*.json&lt;br&gt;(Failed deals)" vertex="1">
