        </mxCell>
        <mxCell id="note7" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Job finished,&lt;br&gt;ready for cleanup&lt;/font&gt;" vertex="1">
