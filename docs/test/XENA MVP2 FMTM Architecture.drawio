        <mxCell id="lc-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF5E7;strokeColor=#E67E22;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;2. Processing Started&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Update status = PROCESSING&lt;br&gt;• Set gridJobId&lt;br&gt;• Set startTime" vertex="1">
          <mxGeometry height="110" width="220" x="459" y="611" as="geometry" />
        </mxCell>
        <mxCell id="lc-arrow2" edge="1" parent="1" source="lc-step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;strokeColor=#4472C4;" target="lc-step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lc-step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;fontSize=11;align=left;fontStyle=0" value="&lt;b&gt;3. Manifest Received&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Update status = COMPLETED&lt;br&gt;• Set endTime&lt;br&gt;• Set completedDeals, failedDeals" vertex="1">
          <mxGeometry height="110" width="220" x="719" y="611" as="geometry" />
        </mxCell>
        <mxCell id="lc-arrow3" edge="1" parent="1" source="lc-step3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;endArrow=classic;endFill=1;strokeColor=#4472C4;" target="lc-step4">
