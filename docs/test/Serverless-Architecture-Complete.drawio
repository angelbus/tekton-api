        <mxCell id="AO6TVO0RdpcXst9PySqn-104" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" value="XDE C++ engine handles all computation.&lt;br&gt;Direct S3 read/write (cross-account IAM).&lt;br&gt;XENA = thin orchestration layer only." vertex="1">
