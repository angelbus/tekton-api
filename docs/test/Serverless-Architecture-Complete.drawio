        <mxCell id="AO6TVO0RdpcXst9PySqn-100" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" value="No EKS/K8s overhead. Pure Lambda + S3 + SQS.&lt;br&gt;Infrastructure scales automatically, pay only for usage." vertex="1">
          <mxGeometry height="40" width="660" x="1480" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="AO6TVO0RdpcXst9PySqn-101" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;2. Eliminated Anti-Patterns&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="680" x="1460" y="1145" as="geometry" />
        </mxCell>
        <mxCell id="AO6TVO0RdpcXst9PySqn-102" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;" value="❌ No BLPOP polling (was causing 10s timeouts)&lt;br&gt;❌ No synchronous blocking&lt;br&gt;✅ Event-driven with S3 ObjectCreated events" vertex="1">
          <mxGeometry height="60" width="660" x="1480" y="1175" as="geometry" />
        </mxCell>
        <mxCell id="AO6TVO0RdpcXst9PySqn-103" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4472C4;" value="&lt;b&gt;3. GRID Does Heavy Lifting&lt;/b&gt;" vertex="1">
