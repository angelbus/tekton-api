        <mxCell id="title-context" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;" value="&lt;b&gt;XENA System - C4 Context Diagram&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="400" x="335" y="20" as="geometry" />
        </mxCell>
        <mxCell id="risk-analysts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#0D5091;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Risk Analysts / Model Validation&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Interact indirectly via risk tools and Sigma/Markets UIs. Require reliable, explainable, and replayable calibration results (PnL, Greeks)." vertex="1">
          <mxGeometry height="120" width="200" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="operations" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#0D5091;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Operations / Run-the-Bank&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Use monitoring and operational tools to manage XENA batches, incidents, and replays. Need clear SLAs, alerts, and recovery procedures." vertex="1">
          <mxGeometry height="120" width="200" x="80" y="270" as="geometry" />
        </mxCell>
        <mxCell id="developers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#0D5091;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Developers / Quant Teams&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Use lower environments (DEV, PRE) for testing models and flows. Need consistent data contracts and reproducible environments." vertex="1">
          <mxGeometry height="120" width="200" x="80" y="420" as="geometry" />
        </mxCell>
        <mxCell id="xena-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;XENA System&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Market data calibration and risk calculation platform. Processes raw market data, calibrates models, and produces PnL, Greeks, and risk metrics for trading and regulatory reporting." vertex="1">
          <mxGeometry height="140" width="270" x="400" y="260" as="geometry" />
        </mxCell>
        <mxCell id="sigma-datalake" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6D6D6D;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Sigma / DataLake&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Provides Parquet-backed datasets (Market, IR Jacobians, Securitizations, Assignments, configurations). Consumes XENA results for CCR analytics." vertex="1">
          <mxGeometry height="120" width="240" x="800" y="120" as="geometry" />
        </mxCell>
        <mxCell id="markets-platforms" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6D6D6D;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Markets Platforms&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Risk &amp; Reporting Systems that consume XENA-produced metrics (calibrated parameters, exposures, PnL, Greeks) for trading, risk management, and regulatory reporting." vertex="1">
          <mxGeometry height="120" width="240" x="800" y="270" as="geometry" />
        </mxCell>
        <mxCell id="batch-schedulers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6D6D6D;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Batch Schedulers&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Control-M, Airflow DAGs trigger daily/intraday calibration and risk processes and manage DAGs." vertex="1">
          <mxGeometry height="100" width="240" x="800" y="430" as="geometry" />
        </mxCell>
        <mxCell id="scib-datalake" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6D6D6D;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;SCIB Data Lake&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;On-premise data storage for raw market data (Jacobians, Calibration Config, Regulatory Scenarios)." vertex="1">
          <mxGeometry height="100" width="240" x="800" y="570" as="geometry" />
