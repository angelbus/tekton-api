        <mxCell id="observability" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6D6D6D;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Observability &amp; Monitoring&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Grafana, CloudWatch, central log platforms collect logs, metrics, and traces used by support teams." vertex="1">
          <mxGeometry height="100" width="200" x="80" y="570" as="geometry" />
