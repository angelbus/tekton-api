  <diagram name="C4 Component - GRIDConnector" id="aH81Ifz5Yhou52T_zqX3">
    <mxGraphModel dx="1685" dy="901" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hJS82S2HU44f2StYQk2V-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1" value="&lt;b&gt;XENA MVP1 - C4 Component Diagram: GRID Connector (EKS Pod)&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="900" x="320" as="geometry" />
        </mxCell>
        <mxCell id="hJS82S2HU44f2StYQk2V-2" parent="1" style="text;html=1;strokeColor=#E67E22;fillColor=#FEF5E7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;arcSize=5;fontStyle=0" value="&lt;b&gt;ARCHITECTURAL ROLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Type: External Integration Adapter&lt;br&gt;Scope: Technical integration ONLY&lt;br&gt;&lt;br&gt;✓ Stateless&lt;br&gt;✓ Does NOT own idempotency&lt;br&gt;✓ Does NOT own output lifecycle&lt;br&gt;✓ Does NOT manage business logic&lt;br&gt;&lt;br&gt;&lt;b&gt;SINGLE RESPONSIBILITY&lt;/b&gt;&lt;br&gt;Isolate platform from external&lt;br&gt;GRID dependency&lt;br&gt;&lt;br&gt;&lt;b&gt;INTEGRATION PATTERN&lt;/b&gt;&lt;br&gt;1. PUT input to GRID Redis&lt;br&gt;2. POST RESTful API to GRID&lt;br&gt;3. Receive processing key&lt;br&gt;4. BLPOP results from GRID Redis" vertex="1">
          <mxGeometry height="310" width="210" x="80" y="60" as="geometry" />
        </mxCell>
        <mxCell id="hJS82S2HU44f2StYQk2V-3" parent="1" style="text;html=1;strokeColor=#8E44AD;fillColor=#F4ECF7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;arcSize=5;fontStyle=0" value="&lt;b&gt;ISOLATION PRINCIPLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;GRIDConnector exists to&lt;br&gt;ISOLATE the platform from&lt;br&gt;external GRID integration.&lt;br&gt;&lt;br&gt;CalibrationService protects&lt;br&gt;the platform FROM GRIDConnector.&lt;br&gt;&lt;br&gt;This separation is DELIBERATE." vertex="1">
          <mxGeometry height="170" width="210" x="80" y="400" as="geometry" />
        </mxCell>
        <mxCell id="hJS82S2HU44f2StYQk2V-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;Calibration Service&lt;/b&gt;&lt;br&gt;[External Container]&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;EKS Pod&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="140" x="80" y="590" as="geometry" />
        </mxCell>
        <mxCell id="hJS82S2HU44f2StYQk2V-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;arcSize=10;" value="&lt;b&gt;GRID Redis&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;MTO GRID AWS&lt;/span&gt;" vertex="1">
