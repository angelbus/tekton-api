        </mxCell>
        
        <!-- Person -->
        <mxCell id="person-c4" value="[Person]&lt;br&gt;&lt;br&gt;&lt;b&gt;End User&lt;/b&gt;&lt;br&gt;&lt;br&gt;Accesses Santander&lt;br&gt;services expecting&lt;br&gt;high availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="200" height="120" as="geometry" />
        </mxCell>
        
        <!-- External System 1: Observation -->
        <mxCell id="ext-observation-c4" value="[External System]&lt;br&gt;&lt;br&gt;&lt;b&gt;External Observation Layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Route 53 Health Checks,&lt;br&gt;Synthetic Monitoring,&lt;br&gt;Datadog&lt;br&gt;&lt;br&gt;Monitors application health&lt;br&gt;from OUTSIDE the infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        
        <!-- Central System -->
        <mxCell id="system-app-c4" value="[Software System]&lt;br&gt;&lt;br&gt;&lt;b&gt;Multi-Region Application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deployed in Frankfurt (primary)&lt;br&gt;and Ireland (secondary)&lt;br&gt;&lt;br&gt;Requires external coordination&lt;br&gt;for true HA/DR capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#ffffff;fontColor=#ffffff;fontSize=16;verticalAlign=top;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="400" height="180" as="geometry" />
        </mxCell>
        
        <!-- External System 2: Traffic Coordination -->
        <mxCell id="ext-traffic-c4" value="[External System]&lt;br&gt;&lt;br&gt;&lt;b&gt;Traffic Coordination Layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Route 53 Failover Policy,&lt;br&gt;Azure Traffic Manager,&lt;br&gt;or Cloudflare&lt;br&gt;&lt;br&gt;Routes user traffic based on&lt;br&gt;health check data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        
        <!-- External System 3: State Sync -->
        <mxCell id="ext-state-c4" value="[External System]&lt;br&gt;&lt;br&gt;&lt;b&gt;State Synchronization Layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aurora Global Database,&lt;br&gt;Redis Global Datastore,&lt;br&gt;S3 Cross-Region Replication&lt;br&gt;&lt;br&gt;Ensures data consistency&lt;br&gt;across regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="640" width="320" height="200" as="geometry" />
        </mxCell>
        
        <!-- Supporting System: Monitoring -->
        <mxCell id="support-monitoring-c4" value="[Supporting System]&lt;br&gt;&lt;br&gt;&lt;b&gt;Unified Monitoring&lt;/b&gt;&lt;br&gt;&lt;br&gt;CloudWatch, Datadog&lt;br&gt;&lt;br&gt;Metrics, logs, traces&lt;br&gt;across all regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="250" height="140" as="geometry" />
        </mxCell>
        
        <!-- Supporting System: Alerting -->
        <mxCell id="support-alerting-c4" value="[Supporting System]&lt;br&gt;&lt;br&gt;&lt;b&gt;Incident Response&lt;/b&gt;&lt;br&gt;&lt;br&gt;PagerDuty, SNS&lt;br&gt;&lt;br&gt;Automated alerting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="250" height="140" as="geometry" />
        </mxCell>
        
        <!-- Person: Ops Team -->
        <mxCell id="ops-team-c4" value="[Person]&lt;br&gt;&lt;br&gt;&lt;b&gt;Operations Team&lt;/b&gt;&lt;br&gt;&lt;br&gt;Monitors system,&lt;br&gt;responds to incidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#ffffff;fontColor=#ffffff;fontSize=14;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="640" width="200" height="120" as="geometry" />
        </mxCell>
        
        <!-- Relationships -->
        
        <mxCell id="rel-user-app" value="Uses application" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=14;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="person-c4" target="system-app-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-user-traffic" value="DNS query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=14;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="person-c4" target="ext-traffic-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-obs-app" value="Monitors health,&lt;br&gt;synthetic tests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=13;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="ext-observation-c4" target="system-app-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-obs-traffic" value="Provides&lt;br&gt;health status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=13;fontStyle=1;" edge="1" parent="1" source="ext-observation-c4" target="ext-traffic-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-traffic-app" value="Routes user traffic&lt;br&gt;based on health" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=3;fontSize=13;fontStyle=1;" edge="1" parent="1" source="ext-traffic-c4" target="system-app-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-state-app" value="Replicates state,&lt;br&gt;synchronizes data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=3;fontSize=13;fontStyle=1;" edge="1" parent="1" source="ext-state-c4" target="system-app-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-mon-app" value="Collects metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=12;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="support-monitoring-c4" target="system-app-c4">
          <mxGeometry relative="1" as="geometry" />
