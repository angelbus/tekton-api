        <mxCell id="rel-alert-ops" value="Sends alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=13;fontStyle=1;" edge="1" parent="1" source="support-alerting-c4" target="ops-team-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="rel-mon-alert" value="Triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#707070;strokeWidth=2;fontSize=12;dashed=1;dashPattern=4 4;" edge="1" parent="1" source="support-monitoring-c4" target="support-alerting-c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Key insight box -->
        <mxCell id="insight-c4" value="KEY INSIGHT:&lt;br&gt;&lt;br&gt;All three coordination systems (Observation, Traffic Coordination, State Sync)&lt;br&gt;are EXTERNAL to the application infrastructure.&lt;br&gt;&lt;br&gt;They must be independent from regional infrastructure to detect and respond&lt;br&gt;to regional failures.&lt;br&gt;&lt;br&gt;❌ Without these → Distributed deployment (not multi-region)&lt;br&gt;✓ With these → True multi-region resilience" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;strokeWidth=3;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="810" width="540" height="200" as="geometry" />
        </mxCell>
        
